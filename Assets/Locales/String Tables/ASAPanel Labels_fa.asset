  m_Name: ASAPanel Labels_fa
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: fa
  m_SharedData: {fileID: 11400000, guid: d3a4387299faa8b81aed682b3107b9e1, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 5787193794560
    m_Localized: "<b>\u062F\u0648\u0633\u062A \u0634\u0645\u0627 \u067E\u0648\u0644
      \u0632\u06CC\u0627\u062F\u06CC \u0646\u062F\u0627\u0631\u062F \u0648 \u0627\u0632
      \u0634\u0645\u0627 \u06F1\u06F0\u06F0 \u06CC\u0648\u0631\u0648 \u0642\u0631\u0636
      \u0645\u06CC\u200C\u062E\u0648\u0627\u0647\u062F. \u0686\u0647 \u067E\u0627\u0633\u062E\u06CC
      \u0628\u0647 \u0627\u0648 \u0645\u06CC\u200C\u062F\u0647\u06CC\u062F\u061F</b>\\n\u06F3\u06F0
      \u062B\u0627\u0646\u06CC\u0647 \u0641\u0631\u0635\u062A \u062F\u0627\u0631\u06CC\u062F."
    m_Metadata:
      m_Items: []
  - m_Id: 5905867431936
    m_Localized: "<b>\u0627\u0645\u0631\u0648\u0632 \u0646\u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u06CC\u062F
      \u0628\u0647 \u06A9\u0644\u0627\u0633/\u0645\u062D\u0644 \u06A9\u0627\u0631
      \u0628\u0631\u0648\u06CC\u062F. \u0628\u0631\u0627\u06CC \u0645\u0639\u0644\u0645/\u0631\u0626\u06CC\u0633
      \u062E\u0648\u062F \u06CC\u06A9 \u067E\u06CC\u0627\u0645 \u0635\u0648\u062A\u06CC
      \u0645\u06CC\u200C\u0641\u0631\u0633\u062A\u06CC\u062F \u0648 \u062A\u0648\u0636\u06CC\u062D
      \u0645\u06CC\u200C\u062F\u0647\u06CC\u062F \u0686\u0631\u0627 \u0646\u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u06CC\u062F
      \u0628\u06CC\u0627\u06CC\u06CC\u062F. \u062F\u0631 \u0627\u06CC\u0646 \u067E\u06CC\u0627\u0645
      \u0686\u0647 \u0645\u06CC\u200C\u06AF\u0648\u06CC\u06CC\u062F\u061F</b>\\n\u06F3\u06F0
      \u062B\u0627\u0646\u06CC\u0647 \u0641\u0631\u0635\u062A \u062F\u0627\u0631\u06CC\u062F."
    m_Metadata:
      m_Items: []
  - m_Id: 5937198882816
    m_Localized: "<b>\u062A\u0648\u0636\u06CC\u062D \u062F\u0647\u06CC\u062F \u06A9\u0647
      \u0645\u0639\u0645\u0648\u0644\u0627\u064B \u062F\u0631 \u062E\u0627\u0646\u0647
      \u0686\u0647 \u06A9\u0627\u0631\u0647\u0627\u06CC\u06CC \u0627\u0646\u062C\u0627\u0645
      \u0645\u06CC\u200C\u062F\u0647\u06CC\u062F.</b>\\n\u06F1 \u062F\u0642\u06CC\u0642\u0647
      \u0641\u0631\u0635\u062A \u062F\u0627\u0631\u06CC\u062F."
    m_Metadata:
      m_Items: []
  - m_Id: 5953061740544
    m_Localized: "<b>\u062A\u0648\u0636\u06CC\u062D \u062F\u0647\u06CC\u062F \u0627\u0632
      \u0686\u0647 \u0632\u0628\u0627\u0646\u200C\u0647\u0627\u06CC\u06CC \u0648
      \u062F\u0631 \u06A9\u062C\u0627 \u0627\u0633\u062A\u0641\u0627\u062F\u0647
      \u0645\u06CC\u200C\u06A9\u0646\u06CC\u062F.</b>\\n\u25CF \u062F\u0631 \u062E\u0627\u0646\u0647\u060C
      \u0641\u0631\u0648\u0634\u06AF\u0627\u0647\u060C \u0645\u062D\u0644 \u06A9\u0627\u0631
      \u0648 ... \u0628\u0647 \u0686\u0647 \u0632\u0628\u0627\u0646\u200C\u0647\u0627\u06CC\u06CC
      \u0635\u062D\u0628\u062A \u0645\u06CC\u200C\u06A9\u0646\u06CC\u062F\u061F\\n\u25CF
      \u0622\u06CC\u0627 \u062A\u0644\u0648\u06CC\u0632\u06CC\u0648\u0646 \u062A\u0645\u0627\u0634\u0627
      \u0645\u06CC\u200C\u06A9\u0646\u06CC\u062F \u06CC\u0627 \u0628\u0647 \u0645\u0648\u0633\u06CC\u0642\u06CC
      \u0628\u0647 \u0632\u0628\u0627\u0646 \u062F\u06CC\u06AF\u0631\u06CC \u06AF\u0648\u0634
      \u0645\u06CC\u200C\u062F\u0647\u06CC\u062F\u061F\\n\u25CF \u0627\u0632 \u0686\u0647
      \u0632\u0628\u0627\u0646\u200C\u0647\u0627\u06CC\u06CC \u0628\u0631\u0627\u06CC
      \u062E\u0648\u0627\u0646\u062F\u0646 \u0648 \u0646\u0648\u0634\u062A\u0646
      \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0645\u06CC\u200C\u06A9\u0646\u06CC\u062F\u061F\\n\u06F1
      \u062F\u0642\u06CC\u0642\u0647 \u0641\u0631\u0635\u062A \u062F\u0627\u0631\u06CC\u062F."
    m_Metadata:
      m_Items: []
  - m_Id: 5968836517888
    m_Localized: "<b>\u0628\u0631 \u0627\u0633\u0627\u0633 \u0639\u0627\u062F\u062A\u200C\u0647\u0627\u06CC
      \u062E\u0631\u06CC\u062F \u062E\u0648\u062F \u06CC\u0627 \u062A\u0635\u0648\u06CC\u0631
      \u0628\u0627\u0644\u0627 \u067E\u0627\u0633\u062E \u062F\u0647\u06CC\u062F.</b>\\n\u25CF
      \u0645\u0639\u0645\u0648\u0644\u0627\u064B \u0686\u0647 \u0686\u06CC\u0632\u0647\u0627\u06CC\u06CC
      \u0627\u0632 \u0641\u0631\u0648\u0634\u06AF\u0627\u0647 \u0645\u06CC\u200C\u062E\u0631\u06CC\u062F\u061F\\n\u25CF
      \u0645\u0639\u0645\u0648\u0644\u0627\u064B \u0686\u0647 \u0686\u06CC\u0632\u0647\u0627\u06CC\u06CC
      \u0627\u0632 \u0641\u0631\u0648\u0634\u06AF\u0627\u0647 \u0646\u0645\u06CC\u200C\u062E\u0631\u06CC\u062F\u061F\\n\u25CF
      \u0645\u0639\u0645\u0648\u0644\u0627\u064B \u0686\u0647 \u0632\u0645\u0627\u0646\u06CC
      \u0628\u0631\u0627\u06CC \u062E\u0631\u06CC\u062F \u0628\u0647 \u0641\u0631\u0648\u0634\u06AF\u0627\u0647
      \u0645\u06CC\u200C\u0631\u0648\u06CC\u062F\u061F\\n\u06F1 \u062F\u0642\u06CC\u0642\u0647
      \u0641\u0631\u0635\u062A \u062F\u0627\u0631\u06CC\u062F."
    m_Metadata:
      m_Items: []
  - m_Id: 7498574684160
    m_Localized: "\u06AF\u0648\u0634 \u06A9\u0646\u06CC\u062F!"
    m_Metadata:
      m_Items: []
  - m_Id: 7558490316800
    m_Localized: "\u0646\u062A\u0627\u06CC\u062C"
    m_Metadata:
