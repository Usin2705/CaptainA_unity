  m_Name: ASAPanel Labels_uk
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: uk
  m_SharedData: {fileID: 11400000, guid: d3a4387299faa8b81aed682b3107b9e1, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 5787193794560
    m_Localized: "<b>\u0423 \u0432\u0430\u0448\u043E\u0433\u043E \u0434\u0440\u0443\u0433\u0430
      \u043C\u0430\u043B\u043E \u0433\u0440\u043E\u0448\u0435\u0439, \u0456 \u0432\u0456\u043D
      \u043F\u0440\u043E\u0441\u0438\u0442\u044C \u0443 \u0432\u0430\u0441 100 \u0454\u0432\u0440\u043E.
      \u0429\u043E \u0432\u0438 \u0439\u043E\u043C\u0443 \u0441\u043A\u0430\u0436\u0435\u0442\u0435?</b>\\n\u0423
      \u0432\u0430\u0441 \u0454 30 \u0441\u0435\u043A\u0443\u043D\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 5905867431936
    m_Localized: "<b>\u0421\u044C\u043E\u0433\u043E\u0434\u043D\u0456 \u0432\u0438
      \u043D\u0435 \u043C\u043E\u0436\u0435\u0442\u0435 \u043F\u0440\u0438\u0439\u0442\u0438
      \u043D\u0430 \u0437\u0430\u043D\u044F\u0442\u0442\u044F/\u0440\u043E\u0431\u043E\u0442\u0443.
      \u0412\u0438 \u043D\u0430\u0434\u0441\u0438\u043B\u0430\u0454\u0442\u0435 \u0433\u043E\u043B\u043E\u0441\u043E\u0432\u0435
      \u043F\u043E\u0432\u0456\u0434\u043E\u043C\u043B\u0435\u043D\u043D\u044F \u0441\u0432\u043E\u0454\u043C\u0443
      \u0432\u0438\u043A\u043B\u0430\u0434\u0430\u0447\u0435\u0432\u0456/\u043A\u0435\u0440\u0456\u0432\u043D\u0438\u043A\u043E\u0432\u0456
      \u0442\u0430 \u043F\u043E\u044F\u0441\u043D\u044E\u0454\u0442\u0435, \u0447\u043E\u043C\u0443
      \u043D\u0435 \u043C\u043E\u0436\u0435\u0442\u0435 \u043F\u0440\u0438\u0439\u0442\u0438.
      \u0429\u043E \u0432\u0438 \u0441\u043A\u0430\u0436\u0435\u0442\u0435 \u0432
      \u043F\u043E\u0432\u0456\u0434\u043E\u043C\u043B\u0435\u043D\u043D\u0456?</b>\\n\u0423
      \u0432\u0430\u0441 \u0454 30 \u0441\u0435\u043A\u0443\u043D\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 5937198882816
    m_Localized: "<b>\u041E\u043F\u0438\u0448\u0456\u0442\u044C, \u0449\u043E \u0432\u0438
      \u0437\u0430\u0437\u0432\u0438\u0447\u0430\u0439 \u0440\u043E\u0431\u0438\u0442\u0435
      \u0432\u0434\u043E\u043C\u0430.</b>\\n\u0423 \u0432\u0430\u0441 \u0454 1 \u0445\u0432\u0438\u043B\u0438\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 5953061740544
    m_Localized: "<b>\u0420\u043E\u0437\u043A\u0430\u0436\u0456\u0442\u044C, \u044F\u043A\u0456
      \u043C\u043E\u0432\u0438 \u0432\u0438 \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u043E\u0432\u0443\u0454\u0442\u0435
      \u0456 \u0434\u0435.</b>\\n\u25CF \u042F\u043A\u0438\u043C\u0438 \u043C\u043E\u0432\u0430\u043C\u0438
      \u0432\u0438 \u0440\u043E\u0437\u043C\u043E\u0432\u043B\u044F\u0454\u0442\u0435
      \u0432\u0434\u043E\u043C\u0430, \u0443 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0456,
      \u043D\u0430 \u0440\u043E\u0431\u043E\u0442\u0456...?\\n\u25CF \u0427\u0438
      \u0434\u0438\u0432\u0438\u0442\u0435\u0441\u044F \u0432\u0438 \u0442\u0435\u043B\u0435\u0431\u0430\u0447\u0435\u043D\u043D\u044F
      \u0430\u0431\u043E \u0441\u043B\u0443\u0445\u0430\u0454\u0442\u0435 \u043C\u0443\u0437\u0438\u043A\u0443
      \u0456\u043D\u0448\u043E\u044E \u043C\u043E\u0432\u043E\u044E?\\n\u25CF \u042F\u043A\u0438\u043C\u0438
      \u043C\u043E\u0432\u0430\u043C\u0438 \u0432\u0438 \u0447\u0438\u0442\u0430\u0454\u0442\u0435
      \u0439 \u043F\u0438\u0448\u0435\u0442\u0435?\\n\u0423 \u0432\u0430\u0441 \u0454
      1 \u0445\u0432\u0438\u043B\u0438\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 5968836517888
    m_Localized: "<b>\u0414\u0430\u0439\u0442\u0435 \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u044C,
      \u0441\u043F\u0438\u0440\u0430\u044E\u0447\u0438\u0441\u044C \u043D\u0430 \u0441\u0432\u043E\u0457
      \u043A\u0443\u043F\u0456\u0432\u0435\u043B\u044C\u043D\u0456 \u0437\u0432\u0438\u0447\u043A\u0438
      \u0430\u0431\u043E \u043D\u0430 \u0437\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u043D\u044F
      \u0432\u0438\u0449\u0435.</b>\\n\u25CF \u0429\u043E \u0432\u0438 \u0437\u0430\u0437\u0432\u0438\u0447\u0430\u0439
      \u043A\u0443\u043F\u0443\u0454\u0442\u0435 \u0432 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0456?\\n\u25CF
      \u0427\u043E\u0433\u043E \u0432\u0438 \u0437\u0430\u0437\u0432\u0438\u0447\u0430\u0439
      \u043D\u0435 \u043A\u0443\u043F\u0443\u0454\u0442\u0435 \u0432 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0456?\\n\u25CF
      \u041A\u043E\u043B\u0438 \u0432\u0438 \u0437\u0430\u0437\u0432\u0438\u0447\u0430\u0439
      \u0445\u043E\u0434\u0438\u0442\u0435 \u0437\u0430 \u043F\u043E\u043A\u0443\u043F\u043A\u0430\u043C\u0438?\\n\u0423
      \u0432\u0430\u0441 \u0454 1 \u0445\u0432\u0438\u043B\u0438\u043D\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 7498574684160
    m_Localized: "\u0421\u043B\u0443\u0445\u0430\u0439\u0442\u0435!"
    m_Metadata:
      m_Items: []
  - m_Id: 7558490316800
    m_Localized: "\u0420\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 9693009371136
    m_Localized: "\u0420\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 9854129364992
    m_Localized: "\u042F\u043A \u0432\u0430\u043C \u0446\u0435 \u0437\u0430\u0432\u0434\u0430\u043D\u043D\u044F?"
    m_Metadata:
      m_Items: []
  - m_Id: 9990498770944
    m_Localized: "\u0422\u0443\u0442 \u0432\u0438 \u043C\u043E\u0436\u0435\u0442\u0435
      \u043D\u0430\u0434\u0430\u0442\u0438 \u0434\u043E\u0434\u0430\u0442\u043A\u043E\u0432\u0438\u0439
      \u0432\u0456\u0434\u0433\u0443\u043A (\u043C\u0430\u043A\u0441. 250 \u0441\u0438\u043C\u0432\u043E\u043B\u0456\u0432)."
    m_Metadata:
      m_Items: []
  - m_Id: 2573893778890752
    m_Localized: "\u041D\u0430\u0434\u0441\u0438\u043B\u0430\u043D\u043D\u044F \u0430\u0443\u0434\u0456\u043E..."
    m_Metadata:
      m_Items: []
  - m_Id: 2574131100999680
    m_Localized: '*Missing translation'
    m_Metadata:
      m_Items: []
  - m_Id: 2574532344897536
    m_Localized: "\u0412\u0430\u0448\u0456 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0438
      \u0433\u043E\u0442\u043E\u0432\u0456. \u041D\u0430\u0442\u0438\u0441\u043D\u0456\u0442\u044C
      \u043D\u0438\u0436\u0447\u0435, \u0449\u043E\u0431 \u043F\u0435\u0440\u0435\u0433\u043B\u044F\u043D\u0443\u0442\u0438
      \u0457\u0445."
