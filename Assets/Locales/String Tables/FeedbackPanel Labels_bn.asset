  - m_Id: 3698728198144
    m_Localized: "\u0986\u09AE\u09B0\u09BE \u09AF\u09BE \u09B6\u09C1\u09A8\u09C7\u099B\u09BF"
    m_Metadata:
      m_Items: []
  - m_Id: 4093949075456
    m_Localized: "\u0986\u09AA\u09A8\u09BE\u09B0 \u0989\u09A4\u09CD\u09A4\u09B0\u099F\u09BF
      \u0995\u09BE\u099C\u09C7\u09B0 \u09B8\u09BE\u09A5\u09C7 \u09AE\u09BF\u09B2\u09C7\u099B\u09C7
      \u09AC\u09B2\u09C7 \u09AE\u09A8\u09C7 \u09B9\u09AF\u09BC\u09A8\u09BF\u0964
      \u0985\u09A8\u09C1\u0997\u09CD\u09B0\u09B9 \u0995\u09B0\u09C7 \u0995\u09BE\u099C\u099F\u09BF
      \u0986\u09AC\u09BE\u09B0 \u09A6\u09C7\u0996\u09C1\u09A8\u0964"
    m_Metadata:
      m_Items: []
  - m_Id: 4361424035840
    m_Localized: "\u0986\u09AA\u09A8\u09BE\u09B0 \u0989\u09A4\u09CD\u09A4\u09B0\u099F\u09BF
      \u0995\u09BE\u099C\u09C7\u09B0 \u09B8\u09BE\u09A5\u09C7 \u0986\u0982\u09B6\u09BF\u0995\u09AD\u09BE\u09AC\u09C7
      \u09AE\u09BF\u09B2\u09C7\u099B\u09C7, \u09A4\u09BE\u0987 \u098F\u0987 \u09B8\u09CD\u0995\u09CB\u09B0\u0997\u09C1\u09B2\u09CB
      \u0986\u09AA\u09A8\u09BE\u09B0 \u09AA\u09CD\u09B0\u0995\u09C3\u09A4 \u09B8\u09CD\u09A4\u09B0
      \u09AA\u09CD\u09B0\u09A4\u09BF\u09AB\u09B2\u09BF\u09A4 \u09A8\u09BE\u0993 \u0995\u09B0\u09A4\u09C7
      \u09AA\u09BE\u09B0\u09C7\u0964 \u098F\u0987 \u09AF\u09BE\u099A\u09BE\u0987
      \u09B8\u09CD\u09AC\u09AF\u09BC\u0982\u0995\u09CD\u09B0\u09BF\u09AF\u09BC \u098F\u09AC\u0982
      \u098F\u099F\u09BF \u09AD\u09C1\u09B2 \u09B9\u09A4\u09C7 \u09AA\u09BE\u09B0\u09C7\u0964"
    m_Metadata:
      m_Items: []
  - m_Id: 4677976547328
    m_Localized: "(\u098F\u0987 \u09B0\u09C7\u0995\u09B0\u09CD\u09A1\u09BF\u0982\u09AF\u09BC\u09C7
      \u0995\u09BF\u099B\u09C1\u0987 \u09B6\u09A8\u09BE\u0995\u09CD\u09A4 \u0995\u09B0\u09BE
      \u09AF\u09BE\u09AF\u09BC\u09A8\u09BF)"
    m_Metadata:
      m_Items: []
  - m_Id: 5920983703552
    m_Localized: "\u099C\u09C7\u09A8\u09C7 \u09AD\u09BE\u09B2\u09CB \u09B2\u09BE\u0997\u09B2!"
    m_Metadata:
      m_Items: []
  - m_Id: 6000499318784
    m_Localized: "\u09B6\u09BF\u09B0\u09CB\u09A8\u09BE\u09AE\u0997\u09C1\u09B2\u09CB\u09B0
      \u09A8\u09BF\u099A\u09C7\u09B0 \u09A4\u09BE\u09B0\u0995\u09BE\u0997\u09C1\u09B2\u09CB\u09A4\u09C7
      \u099A\u09BE\u09AA \u09A6\u09BF\u09AF\u09BC\u09C7 \u0986\u09AA\u09A8\u09BF
      \u09AE\u09A4\u09BE\u09AE\u09A4 \u09B8\u09AE\u09CD\u09AA\u09B0\u09CD\u0995\u09C7
      \u0985\u09A4\u09BF\u09B0\u09BF\u0995\u09CD\u09A4 \u09A4\u09A5\u09CD\u09AF \u09AA\u09C7\u09A4\u09C7
      \u09AA\u09BE\u09B0\u09C7\u09A8:"
    m_Metadata:
      m_Items: []
  - m_Id: 6150844145664
    m_Localized: "\u09A4\u09BE\u09B0\u0995\u09BE\u0997\u09C1\u09B2\u09CB\u09B0 \u09AA\u09BE\u09B6\u09C7
      \u0986\u09AA\u09A8\u09BF \u09AD\u09BE\u09B7\u09BE\u09B0 \u099C\u09A8\u09CD\u09AF
      \u09B8\u09BE\u09A7\u09BE\u09B0\u09A3 \u0987\u0989\u09B0\u09CB\u09AA\u09C0\u09AF\u09BC
      \u09B0\u09C7\u09AB\u09BE\u09B0\u09C7\u09A8\u09CD\u09B8 \u09AB\u09CD\u09B0\u09C7\u09AE\u0993\u09AF\u09BC\u09BE\u09B0\u09CD\u0995
      (A1, A2, A2+, B1) \u0985\u09A8\u09C1\u09AF\u09BE\u09AF\u09BC\u09C0 \u09AA\u09CD\u09B0\u09A4\u09BF\u099F\u09BF
      \u09AA\u09B0\u09BF\u09AE\u09BE\u09AA\u0995\u09C3\u09A4 \u09AC\u09BF\u09AD\u09BE\u0997\u09C7
      \u0986\u09AA\u09A8\u09BE\u09B0 \u09AC\u09B0\u09CD\u09A4\u09AE\u09BE\u09A8 \u09B8\u09CD\u09A4\u09B0\u0993
      \u09A6\u09C7\u0996\u09A4\u09C7 \u09AA\u09BE\u09B0\u09AC\u09C7\u09A8:"
    m_Metadata:
      m_Items: []
  - m_Id: 6162076491776
    m_Localized: "\u0985\u09A8\u09C1\u0997\u09CD\u09B0\u09B9 \u0995\u09B0\u09C7 \u09AE\u09A8\u09C7
      \u09B0\u09BE\u0996\u09AC\u09C7\u09A8, \u098F\u0987 \u0985\u09CD\u09AF\u09BE\u09AA\u09CD\u09B2\u09BF\u0995\u09C7\u09B6\u09A8\u09C7\u09B0
      \u09AE\u09BE\u09A7\u09CD\u09AF\u09AE\u09C7 B2 \u09AC\u09BE \u09A4\u09BE\u09B0
      \u099A\u09C7\u09AF\u09BC\u09C7 \u0989\u099A\u09CD\u099A \u09B8\u09CD\u09A4\u09B0\u09C7\u09B0
      \u09A6\u0995\u09CD\u09B7\u09A4\u09BE\u09AF\u09BC \u09AA\u09CC\u0981\u099B\u09BE\u09A8\u09CB
      \u09B8\u09AE\u09CD\u09AD\u09AC \u09A8\u09AF\u09BC\u0964"
    m_Metadata:
      m_Items: []
  - m_Id: 6343601774592
    m_Localized: "\u09B8\u09BE\u09AE\u0997\u09CD\u09B0\u09BF\u0995 \u0995\u09A5\u09BE
      \u09AC\u09B2\u09BE\u09B0 \u09A6\u0995\u09CD\u09B7\u09A4\u09BE \u09AA\u09B0\u09BF\u09AE\u09BE\u09AA
      \u0995\u09B0\u09C7\u0964"
    m_Metadata:
      m_Items: []
  - m_Id: 6757755740160
    m_Localized: "\u0986\u09AA\u09A8\u09BF \u09B6\u09AC\u09CD\u09A6\u0997\u09C1\u09B2\u09CB
      \u09B8\u09A0\u09BF\u0995\u09AD\u09BE\u09AC\u09C7 \u0989\u099A\u09CD\u099A\u09BE\u09B0\u09A3
      \u0995\u09B0\u09C7\u099B\u09C7\u09A8 \u0995\u09BF\u09A8\u09BE \u09A4\u09BE
      \u09AF\u09BE\u099A\u09BE\u0987 \u0995\u09B0\u09C7\u0964 \u09AE\u09C7\u09B6\u09BF\u09A8
      \u0986\u09AA\u09A8\u09BE\u09B0 \u0995\u09A5\u09BE \u0995\u09A4\u099F\u09BE
      \u09AD\u09BE\u09B2\u09CB\u09AD\u09BE\u09AC\u09C7 \u09AC\u09C1\u099D\u09A4\u09C7
      \u09AA\u09BE\u09B0\u09C7 \u09A4\u09BE \u09AA\u09B0\u09BF\u09AE\u09BE\u09AA
      \u0995\u09B0\u09C7\u0964"
    m_Metadata:
      m_Items: []
  - m_Id: 6846674984960
    m_Localized: "\u09AC\u09CD\u09AF\u09AC\u09B9\u09C3\u09A4 \u09AD\u09BE\u09B7\u09BE\u09B0
      \u09AC\u09C8\u099A\u09BF\u09A4\u09CD\u09B0\u09CD\u09AF \u09AA\u09B0\u09BF\u09AE\u09BE\u09AA
      \u0995\u09B0\u09C7\u0964"
    m_Metadata:
      m_Items: []
  - m_Id: 6874936205312
    m_Localized: "\u09A8\u09BF\u09B0\u09CD\u09AD\u09C1\u09B2\u09A4\u09BE, \u09B6\u09C1\u09A6\u09CD\u09A7\u09A4\u09BE
      \u098F\u09AC\u0982 \u0986\u09AA\u09A8\u09BF \u09AC\u09CD\u09AF\u09BE\u0995\u09B0\u09A3\u09C7\u09B0
      \u09A8\u09BF\u09AF\u09BC\u09AE \u0995\u09A4\u099F\u09BE \u09AD\u09BE\u09B2\u09CB\u09AD\u09BE\u09AC\u09C7
      \u09AE\u09C7\u09A8\u09C7\u099B\u09C7\u09A8 \u09A4\u09BE \u09AA\u09B0\u09BF\u09AE\u09BE\u09AA
      \u0995\u09B0\u09C7\u0964"
    m_Metadata:
      m_Items: []
  - m_Id: 6939780145152
    m_Localized: "\u0986\u09AA\u09A8\u09BE\u09B0 \u0995\u09A5\u09BE\u09B0 \u0997\u09A4\u09BF,
