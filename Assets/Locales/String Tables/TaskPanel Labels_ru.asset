  m_TableData:
  - m_Id: 144860864512
    m_Localized: "\u0412\u044B\u0431\u0435\u0440\u0438 \u0437\u0430\u0434\u0430\u043D\u0438\u0435,
      \u043A\u043E\u0442\u043E\u0440\u043E\u0435 \u0445\u043E\u0447\u0435\u0448\u044C
      \u043F\u043E\u043F\u0440\u0430\u043A\u0442\u0438\u043A\u043E\u0432\u0430\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 352181116928
    m_Localized: "\u041E\u0442\u0440\u0435\u0430\u0433\u0438\u0440\u0443\u0439 \u043D\u0430
      \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044E \u0410"
    m_Metadata:
      m_Items: []
  - m_Id: 444262866944
    m_Localized: "\u041E\u0442\u0440\u0435\u0430\u0433\u0438\u0440\u0443\u0439 \u043D\u0430
      \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044E \u0411"
    m_Metadata:
      m_Items: []
  - m_Id: 453825880064
    m_Localized: "\u041C\u043E\u043D\u043E\u043B\u043E\u0433 \u0410"
    m_Metadata:
      m_Items: []
  - m_Id: 465494433792
    m_Localized: "\u041C\u043E\u043D\u043E\u043B\u043E\u0433 \u0411"
    m_Metadata:
      m_Items: []
  - m_Id: 491620753408
    m_Localized: "\u0420\u0430\u0441\u0441\u043A\u0430\u0436\u0438 \u043E \u043A\u0430\u0440\u0442\u0438\u043D\u043A\u0435"
    m_Metadata:
      m_Items: []
  - m_Id: 1013349871607808
    m_Localized: "\u0417\u0430\u0434\u0430\u043D\u0438\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 1013404976373760
    m_Localized: "\u0417\u0430\u0433\u0440\u0443\u0437\u043A\u0430 \u043F\u0440\u043E\u0444\u0438\u043B\u044F..."
    m_Metadata:
      m_Items: []
  - m_Id: 1015467844132864
    m_Localized: "\u041A\u0430\u043A\u043E\u0432\u044B \u0442\u0432\u043E\u0438 \u043E\u0431\u0449\u0438\u0435
      \u0432\u043F\u0435\u0447\u0430\u0442\u043B\u0435\u043D\u0438\u044F \u043E\u0442
      \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0439
      \u043E\u0446\u0435\u043D\u043A\u0438 \u0443\u0441\u0442\u043D\u043E\u0439 \u0440\u0435\u0447\u0438
      \u043D\u0430 \u0434\u0430\u043D\u043D\u044B\u0439 \u043C\u043E\u043C\u0435\u043D\u0442?"
    m_Metadata:
      m_Items: []
  - m_Id: 1015961052340224
    m_Localized: "\u0417\u0434\u0435\u0441\u044C \u0442\u044B \u043C\u043E\u0436\u0435\u0448\u044C
      \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u043E\u0442\u0437\u044B\u0432 (\u043D\u0435 \u0431\u043E\u043B\u0435\u0435
      250 \u0441\u0438\u043C\u0432\u043E\u043B\u043E\u0432)."
    m_Metadata:
      m_Items: []
