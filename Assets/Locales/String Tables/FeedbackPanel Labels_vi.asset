--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: FeedbackPanel Labels_vi
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: vi
  m_SharedData: {fileID: 11400000, guid: db69d3d55aef5df5fa3b2c531d1f5502, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 616762007552
    m_Localized: "B\u1EA1n c\xF3 th\u1EC3 xem k\u1EBFt qu\u1EA3 b\xEAn d\u01B0\u1EDBi.
      M\xF4 h\xECnh tr\xED tu\u1EC7 nh\xE2n t\u1EA1o s\u1EBD t\u1EF1 \u0111\u1ED9ng
      \u0111\xE1nh gi\xE1 b\u1EA3n ghi \xE2m."
    m_Metadata:
      m_Items: []
  - m_Id: 669878673408
    m_Localized: "Tr\xECnh \u0111\u1ED9"
    m_Metadata:
      m_Items: []
  - m_Id: 2876388761600
    m_Localized: "Ph\xE1t \xE2m"
    m_Metadata:
      m_Items: []
  - m_Id: 2907997036544
    m_Localized: "\u0110\u1ED9 phong ph\xFA"
    m_Metadata:
      m_Items: []
  - m_Id: 2925197877248
    m_Localized: "\u0110\u1ED9 ch\xEDnh x\xE1c"
    m_Metadata:
      m_Items: []
  - m_Id: 2951772987392
    m_Localized: "\u0110\u1ED9 tr\xF4i ch\u1EA3y"
    m_Metadata:
      m_Items: []
  - m_Id: 3049957449728
    m_Localized: "T\u1ED5ng th\u1EC3"
    m_Metadata:
      m_Items: []
  - m_Id: 3382343458816
    m_Localized: "B\u1EA1n th\u1EA5y th\u1EBF n\xE0o?"
    m_Metadata:
      m_Items: []
  - m_Id: 3550702821376
    m_Localized: "B\xE0i luy\u1EC7n m\u1EDBi"
    m_Metadata:
      m_Items: []
  - m_Id: 3698728198144
    m_Localized: "Nh\u1EEFng g\xEC ch\xFAng t\xF4i nghe \u0111\u01B0\u1EE3c"
    m_Metadata:
      m_Items: []
  - m_Id: 4093949075456
    m_Localized: "C\xE2u tr\u1EA3 l\u1EDDi c\u1EE7a b\u1EA1n c\xF3 v\u1EBB kh\xF4ng
      ph\xF9 h\u1EE3p v\u1EDBi y\xEAu c\u1EA7u c\u1EE7a b\xE0i. Vui l\xF2ng \u0111\u1ECDc
      l\u1EA1i \u0111\u1EC1 b\xE0i."
    m_Metadata:
      m_Items: []
  - m_Id: 4361424035840
    m_Localized: "C\xE2u tr\u1EA3 l\u1EDDi c\u1EE7a b\u1EA1n ch\u1EC9 \u0111\xE1p
      \u1EE9ng m\u1ED9t ph\u1EA7n y\xEAu c\u1EA7u, n\xEAn \u0111i\u1EC3m s\u1ED1
      c\xF3 th\u1EC3 ch\u01B0a ph\u1EA3n \xE1nh \u0111\xFAng tr\xECnh \u0111\u1ED9.
      K\u1EBFt qu\u1EA3 ki\u1EC3m tra t\u1EF1 \u0111\u1ED9ng c\xF3 th\u1EC3 kh\xF4ng
      ch\xEDnh x\xE1c."
    m_Metadata:
      m_Items: []
  - m_Id: 4677976547328
    m_Localized: "(Kh\xF4ng nh\u1EADn d\u1EA1ng \u0111\u01B0\u1EE3c n\u1ED9i dung
      n\xE0o trong b\u1EA3n ghi \xE2m n\xE0y)"
    m_Metadata:
      m_Items: []
  - m_Id: 5920983703552
    m_Localized: "Th\xF4ng tin h\u1EEFu \xEDch!"
    m_Metadata:
      m_Items: []
  - m_Id: 6000499318784
    m_Localized: "Nh\u1EA5n v\xE0o c\xE1c ng\xF4i sao b\xEAn d\u01B0\u1EDBi ti\xEAu
      \u0111\u1EC1 \u0111\u1EC3 xem th\xEAm th\xF4ng tin v\u1EC1 t\u1EEBng ti\xEAu
      ch\xED:"
    m_Metadata:
      m_Items: []
  - m_Id: 6150844145664
    m_Localized: "B\xEAn c\u1EA1nh c\xE1c ng\xF4i sao, b\u1EA1n c\u0169ng c\xF3 th\u1EC3
      xem tr\xECnh \u0111\u1ED9 hi\u1EC7n t\u1EA1i c\u1EE7a m\xECnh \u1EDF t\u1EEBng
      ti\xEAu ch\xED theo Khung tham chi\u1EBFu chung ch\xE2u \xC2u v\u1EC1 ng\xF4n
      ng\u1EEF (A1, A2, A2+, B1):"
    m_Metadata:
      m_Items: []
  - m_Id: 6162076491776
    m_Localized: "Xin l\u01B0u \xFD r\u1EB1ng \u1EE9ng d\u1EE5ng n\xE0y ch\u1EC9
      \u0111\xE1nh gi\xE1 \u0111\u1EBFn tr\xECnh \u0111\u1ED9 B1 v\xE0 kh\xF4ng \u0111\u01B0a
      ra k\u1EBFt qu\u1EA3 B2 tr\u1EDF l\xEAn."
    m_Metadata:
      m_Items: []
  - m_Id: 6343601774592
    m_Localized: "\u0110\xE1nh gi\xE1 t\u1ED5ng th\u1EC3 k\u1EF9 n\u0103ng n\xF3i
      c\u1EE7a b\u1EA1n."
    m_Metadata:
      m_Items: []
  - m_Id: 6757755740160
    m_Localized: "Ki\u1EC3m tra c\xE1ch b\u1EA1n ph\xE1t \xE2m t\u1EEB v\xE0 \u0111\xE1nh
      gi\xE1 m\u1EE9c \u0111\u1ED9 h\u1EC7 th\u1ED1ng c\xF3 th\u1EC3 hi\u1EC3u l\u1EDDi
      n\xF3i c\u1EE7a b\u1EA1n."
    m_Metadata:
      m_Items: []
  - m_Id: 6846674984960
    m_Localized: "\u0110\xE1nh gi\xE1 m\u1EE9c \u0111\u1ED9 \u0111a d\u1EA1ng trong
      c\xE1ch s\u1EED d\u1EE5ng ng\xF4n ng\u1EEF."
    m_Metadata:
      m_Items: []
  - m_Id: 6874936205312
    m_Localized: "\u0110\xE1nh gi\xE1 \u0111\u1ED9 ch\xEDnh x\xE1c v\xE0 m\u1EE9c
      \u0111\u1ED9 tu\xE2n th\u1EE7 c\xE1c quy t\u1EAFc ng\u1EEF ph\xE1p."
    m_Metadata:
      m_Items: []
  - m_Id: 6939780145152
    m_Localized: "\u0110\xE1nh gi\xE1 t\u1ED1c \u0111\u1ED9 n\xF3i, c\xE1c qu\xE3ng
      ng\u1EEBng v\xE0 s\u1EF1 ng\u1EADp ng\u1EEBng."
    m_Metadata:
      m_Items: []
  - m_Id: 7719484481536
    m_Localized: "B\u1EA1n c\xF3 th\u1EA5y k\u1EBFt qu\u1EA3 n\xE0y ch\xEDnh x\xE1c
      kh\xF4ng?"
    m_Metadata:
      m_Items: []
  - m_Id: 8025454764032
    m_Localized: "K\u1EBFt qu\u1EA3 c\xF3 d\u1EC5 hi\u1EC3u kh\xF4ng?"
    m_Metadata:
      m_Items: []
  - m_Id: 8115305144320
    m_Localized: "B\u1EA1n c\xF3 th\u1EC3 g\xF3p \xFD th\xEAm t\u1EA1i \u0111\xE2y
      (t\u1ED1i \u0111a 250 k\xFD t\u1EF1)."
    m_Metadata:
      m_Items: []
  - m_Id: 8203180007424
    m_Localized: "G\u1EEDi"
    m_Metadata:
      m_Items: []
  - m_Id: 10626791464960
    m_Localized: "Ph\u1EA3n h\u1ED3i"
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
