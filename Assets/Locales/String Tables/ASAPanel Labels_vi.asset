  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: ASAPanel Labels_vi
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: vi
  m_SharedData: {fileID: 11400000, guid: d3a4387299faa8b81aed682b3107b9e1, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 5787193794560
    m_Localized: "<b>B\u1EA1n c\u1EE7a b\u1EA1n kh\xF4ng c\xF3 nhi\u1EC1u ti\u1EC1n
      v\xE0 h\u1ECFi vay b\u1EA1n 100 euro. B\u1EA1n s\u1EBD n\xF3i g\xEC v\u1EDBi
      ng\u01B0\u1EDDi \u0111\xF3?</b>\\nB\u1EA1n c\xF3 30 gi\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 5905867431936
    m_Localized: "<b>H\xF4m nay b\u1EA1n kh\xF4ng th\u1EC3 \u0111\u1EBFn l\u1EDBp/\u0111i
      l\xE0m. H\xE3y g\u1EEDi tin nh\u1EAFn tho\u1EA1i cho gi\xE1o vi\xEAn/c\u1EA5p
      tr\xEAn \u0111\u1EC3 gi\u1EA3i th\xEDch l\xFD do b\u1EA1n kh\xF4ng th\u1EC3
      \u0111\u1EBFn. B\u1EA1n s\u1EBD n\xF3i g\xEC?</b>\\nB\u1EA1n c\xF3 30 gi\xE2y."
    m_Metadata:
      m_Items: []
  - m_Id: 5937198882816
    m_Localized: "<b>H\xE3y n\xF3i v\u1EC1 nh\u1EEFng vi\u1EC7c b\u1EA1n th\u01B0\u1EDDng
      l\xE0m \u1EDF nh\xE0.</b>\\nB\u1EA1n c\xF3 1 ph\xFAt."
    m_Metadata:
      m_Items: []
  - m_Id: 5953061740544
    m_Localized: "<b>H\xE3y n\xF3i v\u1EC1 nh\u1EEFng ng\xF4n ng\u1EEF b\u1EA1n s\u1EED
      d\u1EE5ng v\xE0 n\u01A1i b\u1EA1n s\u1EED d\u1EE5ng ch\xFAng.</b>\\n\u25CF
      B\u1EA1n n\xF3i ng\xF4n ng\u1EEF n\xE0o \u1EDF nh\xE0, \u1EDF c\u1EEDa h\xE0ng,
      t\u1EA1i n\u01A1i l\xE0m vi\u1EC7c...?\\n\u25CF B\u1EA1n c\xF3 xem TV ho\u1EB7c
      nghe nh\u1EA1c b\u1EB1ng ng\xF4n ng\u1EEF kh\xE1c kh\xF4ng?\\n\u25CF B\u1EA1n
      \u0111\u1ECDc v\xE0 vi\u1EBFt b\u1EB1ng nh\u1EEFng ng\xF4n ng\u1EEF n\xE0o?\\nB\u1EA1n
      c\xF3 1 ph\xFAt."
    m_Metadata:
      m_Items: []
  - m_Id: 5968836517888
    m_Localized: "<b>H\xE3y tr\u1EA3 l\u1EDDi d\u1EF1a tr\xEAn th\xF3i quen mua s\u1EAFm
      c\u1EE7a b\u1EA1n ho\u1EB7c b\u1EE9c tranh \u1EDF tr\xEAn.</b>\\n\u25CF B\u1EA1n
      th\u01B0\u1EDDng mua g\xEC \u1EDF c\u1EEDa h\xE0ng?\\n\u25CF B\u1EA1n th\u01B0\u1EDDng
      kh\xF4ng mua g\xEC \u1EDF c\u1EEDa h\xE0ng?\\n\u25CF B\u1EA1n th\u01B0\u1EDDng
      \u0111i mua s\u1EAFm khi n\xE0o?\\nB\u1EA1n c\xF3 1 ph\xFAt."
    m_Metadata:
      m_Items: []
  - m_Id: 7498574684160
    m_Localized: Nghe!
    m_Metadata:
      m_Items: []
  - m_Id: 7558490316800
    m_Localized: "K\u1EBFt qu\u1EA3"
    m_Metadata:
      m_Items: []
  - m_Id: 9693009371136
    m_Localized: "K\u1EBFt qu\u1EA3"
    m_Metadata:
      m_Items: []
  - m_Id: 9854129364992
    m_Localized: "B\u1EA1n th\u1EA5y b\xE0i luy\u1EC7n n\xF3i n\xE0y th\u1EBF n\xE0o?"
    m_Metadata:
      m_Items: []
  - m_Id: 9990498770944
    m_Localized: "B\u1EA1n c\xF3 th\u1EC3 g\xF3p \xFD th\xEAm t\u1EA1i \u0111\xE2y
      (t\u1ED1i \u0111a 250 k\xFD t\u1EF1)."
    m_Metadata:
      m_Items: []
  - m_Id: 2573893778890752
    m_Localized: "\u0110ang g\u1EEDi b\u1EA3n ghi \xE2m..."
    m_Metadata:
      m_Items: []
  - m_Id: 2574131100999680
    m_Localized: '*Missing translation'
    m_Metadata:
      m_Items: []
  - m_Id: 2574532344897536
    m_Localized: "K\u1EBFt qu\u1EA3 \u0111\xE3 s\u1EB5n s\xE0ng. Nh\u1EA5n v\xE0o
      n\xFAt b\xEAn d\u01B0\u1EDBi \u0111\u1EC3 xem."
    m_Metadata:
      m_Items: []
  - m_Id: 6320358917496832
    m_Localized: '*Missing translation'
    m_Metadata:
      m_Items: []
