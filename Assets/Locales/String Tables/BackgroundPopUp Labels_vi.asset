  m_TableData:
  - m_Id: 77265461248
    m_Localized: "Tr\u01B0\u1EDBc khi b\u1EAFt \u0111\u1EA7u, ch\xFAng t\xF4i c\u1EA7n
      m\u1ED9t s\u1ED1 th\xF4ng tin c\u01A1 b\u1EA3n v\u1EC1 b\u1EA1n."
    m_Metadata:
      m_Items: []
  - m_Id: 192822730752
    m_Localized: "1. Gi\u1EDBi t\xEDnh *"
    m_Metadata:
      m_Items: []
  - m_Id: 278487195648
    m_Localized: "N\u1EEF"
    m_Metadata:
      m_Items: []
  - m_Id: 317800407040
    m_Localized: Nam
    m_Metadata:
      m_Items: []
  - m_Id: 329296994304
    m_Localized: "Kh\xE1c"
    m_Metadata:
      m_Items: []
  - m_Id: 339820503040
    m_Localized: "Kh\xF4ng mu\u1ED1n tr\u1EA3 l\u1EDDi"
    m_Metadata:
      m_Items: []
  - m_Id: 506409869312
    m_Localized: "2. Tu\u1ED5i *"
    m_Metadata:
      m_Items: []
  - m_Id: 583144660992
    m_Localized: "T\u1EEB 62 tr\u1EDF l\xEAn"
    m_Metadata:
      m_Items: []
  - m_Id: 2623191212032
    m_Localized: "3. T\u1EF1 \u0111\xE1nh gi\xE1 tr\xECnh \u0111\u1ED9 ti\u1EBFng
      Ph\u1EA7n Lan *"
    m_Metadata:
      m_Items: []
  - m_Id: 2807337934848
    m_Localized: "A1 (M\u1EDBi b\u1EAFt \u0111\u1EA7u)"
    m_Metadata:
      m_Items: []
  - m_Id: 2844952453120
    m_Localized: "A2 (S\u01A1 c\u1EA5p)"
    m_Metadata:
      m_Items: []
  - m_Id: 2858856570880
    m_Localized: "B1 (Trung c\u1EA5p)"
    m_Metadata:
      m_Items: []
  - m_Id: 2872630665216
    m_Localized: "B2 (Trung c\u1EA5p cao)"
    m_Metadata:
      m_Items: []
  - m_Id: 2888006983680
    m_Localized: "C1 tr\u1EDF l\xEAn (N\xE2ng cao/Th\xE0nh th\u1EA1o)"
    m_Metadata:
      m_Items: []
  - m_Id: 3531392245760
    m_Localized: "4. Ti\u1EBFng m\u1EB9 \u0111\u1EBB *"
    m_Metadata:
      m_Items: []
  - m_Id: 3572320264192
    m_Localized: "5. Nh\u1EEFng ng\xF4n ng\u1EEF kh\xE1c b\u1EA1n c\xF3 th\u1EC3
      n\xF3i"
    m_Metadata:
      m_Items: []
  - m_Id: 3598673076224
    m_Localized: "Nh\u1EADp n\u1ED9i dung..."
    m_Metadata:
      m_Items: []
  - m_Id: 3631447367680
    m_Localized: "G\u1EEDi"
    m_Metadata:
      m_Items: []
  - m_Id: 3840030105600
    m_Localized: "Vui l\xF2ng tr\u1EA3 l\u1EDDi t\u1EA5t c\u1EA3 c\xE1c c\xE2u h\u1ECFi
      b\u1EAFt bu\u1ED9c."
    m_Metadata:
      m_Items: []
