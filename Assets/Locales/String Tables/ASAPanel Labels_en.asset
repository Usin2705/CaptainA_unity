  m_TableData:
  - m_Id: 5787193794560
    m_Localized: <b>Your friend doesn't have much money and asks you for 100 euros.
      What do you say to them?</b>\nYou have 30 seconds.
    m_Metadata:
      m_Items: []
  - m_Id: 5905867431936
    m_Localized: '<b>You can''t come to class/work today. You send a voice message
      to your teacher/boss and tell them why you can''t come. What do you say in
      the message?</b>\nYou have 30 seconds. '
    m_Metadata:
      m_Items: []
  - m_Id: 5937198882816
    m_Localized: '<b>Describe what you normally do at home.</b>\nYou have 1 minute. '
    m_Metadata:
      m_Items: []
  - m_Id: 5953061740544
    m_Localized: "<b>Describe what languages you use and where.</b>\\n\u25CF What
      languages do you speak at home, in the shop, at work...?\\n\u25CF Do you watch
      TV or listen to music in another language?\\nYou have 1 minute. "
    m_Metadata:
      m_Items: []
  - m_Id: 5968836517888
    m_Localized: "<b>Please answer based on your shopping habits or the picture above.</b>\\n\u25CF
      What do you normally buy at the store?\\n\u25CF What don't you normally buy
      from the store?\\n\u25CF When do you normally go shopping?\\nYou have 1 minute."
    m_Metadata:
      m_Items: []
  - m_Id: 7498574684160
    m_Localized: Listen!
    m_Metadata:
      m_Items: []
  - m_Id: 7558490316800
    m_Localized: Results
    m_Metadata:
      m_Items: []
  - m_Id: 7815626317824
    m_Localized: Sending the audio...
    m_Metadata:
      m_Items: []
  - m_Id: 7948766109696
    m_Localized: Your results are ready. Tap below to see them.
    m_Metadata:
      m_Items: []
  - m_Id: 9693009371136
    m_Localized: Results
    m_Metadata:
      m_Items: []
  - m_Id: 9732582629376
    m_Localized: Something went wrong!
    m_Metadata:
      m_Items: []
  - m_Id: 9854129364992
    m_Localized: How did you find this task?
    m_Metadata:
      m_Items: []
  - m_Id: 9990498770944
    m_Localized: Here you can provide additional feedback (max. 250 characters).
    m_Metadata:
      m_Items: []
