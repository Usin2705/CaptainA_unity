  m_TableData:
  - m_Id: 616762007552
    m_Localized: "\u041D\u0438\u0436\u0447\u0435 \u0432\u0438 \u043C\u043E\u0436\u0435\u0442\u0435
      \u043F\u0435\u0440\u0435\u0433\u043B\u044F\u043D\u0443\u0442\u0438 \u0441\u0432\u043E\u0457
      \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0438. \u0417\u0430\u043F\u0438\u0441
      \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u043D\u043E \u043E\u0446\u0456\u043D\u044E\u0454\u0442\u044C\u0441\u044F
      \u043C\u043E\u0434\u0435\u043B\u043B\u044E \u0448\u0442\u0443\u0447\u043D\u043E\u0433\u043E
      \u0456\u043D\u0442\u0435\u043B\u0435\u043A\u0442\u0443."
    m_Metadata:
      m_Items: []
  - m_Id: 669878673408
    m_Localized: "\u0420\u0456\u0432\u0435\u043D\u044C \u0432\u043E\u043B\u043E\u0434\u0456\u043D\u043D\u044F
      \u043C\u043E\u0432\u043E\u044E"
    m_Metadata:
      m_Items: []
  - m_Id: 2876388761600
    m_Localized: "\u0412\u0438\u043C\u043E\u0432\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 2907997036544
    m_Localized: "\u041C\u043E\u0432\u043D\u0438\u0439 \u0434\u0456\u0430\u043F\u0430\u0437\u043E\u043D"
    m_Metadata:
      m_Items: []
  - m_Id: 2925197877248
    m_Localized: "\u0422\u043E\u0447\u043D\u0456\u0441\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 2951772987392
    m_Localized: "\u041F\u043B\u0430\u0432\u043D\u0456\u0441\u0442\u044C \u043C\u043E\u0432\u043B\u0435\u043D\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 3049957449728
    m_Localized: "\u0417\u0430\u0433\u0430\u043B\u044C\u043D\u0430 \u043E\u0446\u0456\u043D\u043A\u0430"
    m_Metadata:
      m_Items: []
  - m_Id: 3382343458816
    m_Localized: "\u0429\u043E \u0432\u0438 \u0434\u0443\u043C\u0430\u0454\u0442\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 3550702821376
    m_Localized: "\u041D\u043E\u0432\u0435 \u0437\u0430\u0432\u0434\u0430\u043D\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 3698728198144
    m_Localized: "\u0429\u043E \u043C\u0438 \u043F\u043E\u0447\u0443\u043B\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 4093949075456
    m_Localized: "\u0421\u0445\u043E\u0436\u0435, \u0432\u0430\u0448\u0430 \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u044C
      \u043D\u0435 \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u0430\u043B\u0430
      \u0437\u0430\u0432\u0434\u0430\u043D\u043D\u044E. \u041F\u0435\u0440\u0435\u0432\u0456\u0440\u0442\u0435
      \u0437\u0430\u0432\u0434\u0430\u043D\u043D\u044F \u0449\u0435 \u0440\u0430\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 4361424035840
    m_Localized: "\u0412\u0430\u0448\u0430 \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u044C
      \u043B\u0438\u0448\u0435 \u0447\u0430\u0441\u0442\u043A\u043E\u0432\u043E \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u0430\u043B\u0430
      \u0437\u0430\u0432\u0434\u0430\u043D\u043D\u044E, \u0442\u043E\u043C\u0443
      \u0446\u0456 \u0431\u0430\u043B\u0438 \u043C\u043E\u0436\u0443\u0442\u044C
      \u043D\u0435 \u0432\u0456\u0434\u043E\u0431\u0440\u0430\u0436\u0430\u0442\u0438
      \u0432\u0430\u0448 \u0441\u043F\u0440\u0430\u0432\u0436\u043D\u0456\u0439 \u0440\u0456\u0432\u0435\u043D\u044C.
      \u0426\u044F \u043F\u0435\u0440\u0435\u0432\u0456\u0440\u043A\u0430 \u0432\u0438\u043A\u043E\u043D\u0443\u0454\u0442\u044C\u0441\u044F
      \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u043D\u043E \u0439 \u043C\u043E\u0436\u0435
      \u0431\u0443\u0442\u0438 \u043F\u043E\u043C\u0438\u043B\u043A\u043E\u0432\u043E\u044E."
    m_Metadata:
      m_Items: []
  - m_Id: 4677976547328
    m_Localized: "(\u0423 \u0446\u044C\u043E\u043C\u0443 \u0437\u0430\u043F\u0438\u0441\u0456
      \u043D\u0456\u0447\u043E\u0433\u043E \u043D\u0435 \u0440\u043E\u0437\u043F\u0456\u0437\u043D\u0430\u043D\u043E)"
    m_Metadata:
      m_Items: []
  - m_Id: 5920983703552
    m_Localized: "\u041A\u043E\u0440\u0438\u0441\u043D\u043E \u0437\u043D\u0430\u0442\u0438!"
    m_Metadata:
      m_Items: []
  - m_Id: 6000499318784
    m_Localized: "\u0412\u0438 \u043C\u043E\u0436\u0435\u0442\u0435 \u043E\u0442\u0440\u0438\u043C\u0430\u0442\u0438
      \u0434\u043E\u0434\u0430\u0442\u043A\u043E\u0432\u0443 \u0456\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0456\u044E
      \u043F\u0440\u043E \u0432\u0456\u0434\u0433\u0443\u043A, \u043D\u0430\u0442\u0438\u0441\u043D\u0443\u0432\u0448\u0438
      \u043D\u0430 \u0437\u0456\u0440\u043E\u0447\u043A\u0438 \u043F\u0456\u0434
      \u0437\u0430\u0433\u043E\u043B\u043E\u0432\u043A\u0430\u043C\u0438:"
    m_Metadata:
      m_Items: []
  - m_Id: 6150844145664
    m_Localized: "\u041F\u043E\u0440\u0443\u0447 \u0456\u0437 \u0437\u0456\u0440\u043E\u0447\u043A\u0430\u043C\u0438
      \u0432\u0438 \u0442\u0430\u043A\u043E\u0436 \u043C\u043E\u0436\u0435\u0442\u0435
      \u043F\u043E\u0431\u0430\u0447\u0438\u0442\u0438 \u0441\u0432\u0456\u0439 \u043F\u043E\u0442\u043E\u0447\u043D\u0438\u0439
      \u0440\u0456\u0432\u0435\u043D\u044C \u0443 \u043A\u043E\u0436\u043D\u0456\u0439
      \u043E\u0446\u0456\u043D\u044E\u0432\u0430\u043D\u0456\u0439 \u043A\u0430\u0442\u0435\u0433\u043E\u0440\u0456\u0457
      \u0432\u0456\u0434\u043F\u043E\u0432\u0456\u0434\u043D\u043E \u0434\u043E \u0417\u0430\u0433\u0430\u043B\u044C\u043D\u043E\u0454\u0432\u0440\u043E\u043F\u0435\u0439\u0441\u044C\u043A\u0438\u0445
      \u0440\u0435\u043A\u043E\u043C\u0435\u043D\u0434\u0430\u0446\u0456\u0439 \u0437
      \u043C\u043E\u0432\u043D\u043E\u0457 \u043E\u0441\u0432\u0456\u0442\u0438 (A1,
      A2, A2+, B1):"
    m_Metadata:
      m_Items: []
  - m_Id: 6162076491776
    m_Localized: "\u0417\u0432\u0435\u0440\u043D\u0456\u0442\u044C \u0443\u0432\u0430\u0433\u0443:
      \u0443 \u0446\u044C\u043E\u043C\u0443 \u0437\u0430\u0441\u0442\u043E\u0441\u0443\u043D\u043A\u0443
      \u043D\u0435\u043C\u043E\u0436\u043B\u0438\u0432\u043E \u0434\u043E\u0441\u044F\u0433\u0442\u0438
      \u0440\u0456\u0432\u043D\u044F \u0432\u043E\u043B\u043E\u0434\u0456\u043D\u043D\u044F
      \u043C\u043E\u0432\u043E\u044E B2 \u0430\u0431\u043E \u0432\u0438\u0449\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 6343601774592
    m_Localized: "\u041E\u0446\u0456\u043D\u044E\u0454 \u0437\u0430\u0433\u0430\u043B\u044C\u043D\u0443
      \u0437\u0434\u0430\u0442\u043D\u0456\u0441\u0442\u044C \u0433\u043E\u0432\u043E\u0440\u0438\u0442\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 6757755740160
    m_Localized: "\u041F\u0435\u0440\u0435\u0432\u0456\u0440\u044F\u0454, \u0447\u0438
      \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E \u0432\u0438 \u0432\u0438\u043C\u043E\u0432\u043B\u044F\u043B\u0438
      \u0441\u043B\u043E\u0432\u0430. \u041E\u0446\u0456\u043D\u044E\u0454, \u043D\u0430\u0441\u043A\u0456\u043B\u044C\u043A\u0438
      \u0434\u043E\u0431\u0440\u0435 \u0441\u0438\u0441\u0442\u0435\u043C\u0430 \u0440\u043E\u0437\u0443\u043C\u0456\u0454
      \u0432\u0430\u0448\u0435 \u043C\u043E\u0432\u043B\u0435\u043D\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 6846674984960
    m_Localized: "\u041E\u0446\u0456\u043D\u044E\u0454 \u0440\u0456\u0437\u043D\u043E\u043C\u0430\u043D\u0456\u0442\u043D\u0456\u0441\u0442\u044C
      \u0432\u0438\u043A\u043E\u0440\u0438\u0441\u0442\u0430\u043D\u043E\u0457 \u043C\u043E\u0432\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 6874936205312
    m_Localized: "\u041E\u0446\u0456\u043D\u044E\u0454 \u0442\u043E\u0447\u043D\u0456\u0441\u0442\u044C,
      \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u0456\u0441\u0442\u044C \u0456
      \u0442\u0435, \u043D\u0430\u0441\u043A\u0456\u043B\u044C\u043A\u0438 \u0434\u043E\u0431\u0440\u0435
      \u0432\u0438 \u0434\u043E\u0442\u0440\u0438\u043C\u0443\u0432\u0430\u043B\u0438\u0441\u044F
      \u0433\u0440\u0430\u043C\u0430\u0442\u0438\u0447\u043D\u0438\u0445 \u043F\u0440\u0430\u0432\u0438\u043B."
    m_Metadata:
      m_Items: []
  - m_Id: 6939780145152
    m_Localized: "\u041E\u0446\u0456\u043D\u044E\u0454 \u0448\u0432\u0438\u0434\u043A\u0456\u0441\u0442\u044C
      \u043C\u043E\u0432\u043B\u0435\u043D\u043D\u044F, \u043F\u0430\u0443\u0437\u0438
      \u0442\u0430 \u0432\u0430\u0433\u0430\u043D\u043D\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 7719484481536
    m_Localized: "\u041D\u0430 \u0432\u0430\u0448\u0443 \u0434\u0443\u043C\u043A\u0443,
      \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442 \u0442\u043E\u0447\u043D\u0438\u0439?"
    m_Metadata:
      m_Items: []
  - m_Id: 8025454764032
    m_Localized: "\u0427\u0438 \u043B\u0435\u0433\u043A\u043E \u0431\u0443\u043B\u043E
      \u0437\u0440\u043E\u0437\u0443\u043C\u0456\u0442\u0438 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442?"
    m_Metadata:
      m_Items: []
  - m_Id: 8115305144320
    m_Localized: "\u0422\u0443\u0442 \u0432\u0438 \u043C\u043E\u0436\u0435\u0442\u0435
      \u043D\u0430\u0434\u0430\u0442\u0438 \u0434\u043E\u0434\u0430\u0442\u043A\u043E\u0432\u0438\u0439
      \u0432\u0456\u0434\u0433\u0443\u043A (\u043C\u0430\u043A\u0441. 250 \u0441\u0438\u043C\u0432\u043E\u043B\u0456\u0432)."
    m_Metadata:
      m_Items: []
  - m_Id: 8203180007424
    m_Localized: "\u041D\u0430\u0434\u0456\u0441\u043B\u0430\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 10626791464960
    m_Localized: "\u0412\u0456\u0434\u0433\u0443\u043A"
    m_Metadata:
      m_Items: []
