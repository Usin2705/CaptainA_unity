      \u0634\u0645\u0627 \u0628\u0647\u200C\u0637\u0648\u0631 \u062E\u0648\u062F\u06A9\u0627\u0631
      \u062A\u0648\u0633\u0637 \u06CC\u06A9 \u0645\u062F\u0644 \u0647\u0648\u0634
