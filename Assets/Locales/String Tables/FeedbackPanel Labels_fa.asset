  - m_Id: 3698728198144
    m_Localized: "\u0622\u0646\u0686\u0647 \u0645\u0627 \u0634\u0646\u06CC\u062F\u06CC\u0645"
    m_Metadata:
      m_Items: []
  - m_Id: 4093949075456
    m_Localized: "\u067E\u0627\u0633\u062E \u0634\u0645\u0627 \u0638\u0627\u0647\u0631\u0627\u064B
      \u0628\u0627 \u062A\u0645\u0631\u06CC\u0646 \u0645\u0637\u0627\u0628\u0642\u062A
      \u0646\u062F\u0627\u0634\u062A. \u0644\u0637\u0641\u0627\u064B \u062F\u0648\u0628\u0627\u0631\u0647
      \u062A\u0645\u0631\u06CC\u0646 \u0631\u0627 \u0628\u0631\u0631\u0633\u06CC
      \u06A9\u0646\u06CC\u062F."
    m_Metadata:
      m_Items: []
  - m_Id: 4361424035840
    m_Localized: "\u067E\u0627\u0633\u062E \u0634\u0645\u0627 \u0641\u0642\u0637
      \u062A\u0627 \u062D\u062F\u06CC \u0628\u0627 \u062A\u0645\u0631\u06CC\u0646
      \u0645\u0637\u0627\u0628\u0642\u062A \u062F\u0627\u0634\u062A\u061B \u0628\u0646\u0627\u0628\u0631\u0627\u06CC\u0646
      \u0645\u0645\u06A9\u0646 \u0627\u0633\u062A \u0627\u06CC\u0646 \u0627\u0645\u062A\u06CC\u0627\u0632\u0647\u0627
      \u0633\u0637\u062D \u0648\u0627\u0642\u0639\u06CC \u0634\u0645\u0627 \u0631\u0627
      \u0646\u0634\u0627\u0646 \u0646\u062F\u0647\u0646\u062F. \u0627\u06CC\u0646
      \u0628\u0631\u0631\u0633\u06CC \u0628\u0647\u200C\u0635\u0648\u0631\u062A \u062E\u0648\u062F\u06A9\u0627\u0631
      \u0627\u0646\u062C\u0627\u0645 \u0645\u06CC\u200C\u0634\u0648\u062F \u0648
      \u0645\u0645\u06A9\u0646 \u0627\u0633\u062A \u0627\u0634\u062A\u0628\u0627\u0647
      \u0628\u0627\u0634\u062F."
    m_Metadata:
      m_Items: []
  - m_Id: 4677976547328
    m_Localized: "(\u06AF\u0641\u062A\u0627\u0631\u06CC \u062F\u0631 \u0627\u06CC\u0646
      \u0636\u0628\u0637 \u062A\u0634\u062E\u06CC\u0635 \u062F\u0627\u062F\u0647
      \u0646\u0634\u062F.)"
    m_Metadata:
      m_Items: []
  - m_Id: 5920983703552
    m_Localized: "\u062E\u0648\u0628 \u0627\u0633\u062A \u0628\u062F\u0627\u0646\u0645!"
    m_Metadata:
      m_Items: []
  - m_Id: 6000499318784
    m_Localized: "\u0628\u0631\u0627\u06CC \u062F\u0631\u06CC\u0627\u0641\u062A \u0627\u0637\u0644\u0627\u0639\u0627\u062A
      \u0628\u06CC\u0634\u062A\u0631 \u062F\u0631\u0628\u0627\u0631\u0647 \u0628\u0627\u0632\u062E\u0648\u0631\u062F\u060C
      \u0631\u0648\u06CC \u0633\u062A\u0627\u0631\u0647\u200C\u0647\u0627\u06CC \u0632\u06CC\u0631
      \u0639\u0646\u0648\u0627\u0646\u200C\u0647\u0627 \u0628\u0632\u0646\u06CC\u062F."
    m_Metadata:
      m_Items: []
  - m_Id: 6150844145664
    m_Localized: "\u0647\u0645\u0686\u0646\u06CC\u0646 \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u06CC\u062F
      \u0633\u0637\u062D \u0641\u0639\u0644\u06CC \u062E\u0648\u062F \u0631\u0627
      \u062F\u0631 \u0647\u0631 \u06CC\u06A9 \u0627\u0632 \u062F\u0633\u062A\u0647\u200C\u0647\u0627\u06CC
      \u0627\u0631\u0632\u06CC\u0627\u0628\u06CC\u200C\u0634\u062F\u0647\u060C \u0628\u0631
      \u0627\u0633\u0627\u0633 \u0686\u0627\u0631\u0686\u0648\u0628 \u0645\u0634\u062A\u0631\u06A9
      \u0627\u0631\u0648\u067E\u0627\u06CC\u06CC \u0645\u0631\u062C\u0639 \u0628\u0631\u0627\u06CC
      \u0632\u0628\u0627\u0646\u200C\u0647\u0627 (CEFR: A1\u060C A2\u060C A2+\u060C
      B1)\u060C \u062F\u0631 \u06A9\u0646\u0627\u0631 \u0633\u062A\u0627\u0631\u0647\u200C\u0647\u0627
      \u0645\u0634\u0627\u0647\u062F\u0647 \u06A9\u0646\u06CC\u062F."
    m_Metadata:
      m_Items: []
  - m_Id: 6162076491776
    m_Localized: "\u0644\u0637\u0641\u0627\u064B \u062A\u0648\u062C\u0647 \u062F\u0627\u0634\u062A\u0647
      \u0628\u0627\u0634\u06CC\u062F \u06A9\u0647 \u0628\u0627 \u0627\u0633\u062A\u0641\u0627\u062F\u0647
      \u0627\u0632 \u0627\u06CC\u0646 \u0628\u0631\u0646\u0627\u0645\u0647 \u0627\u0645\u06A9\u0627\u0646
      \u062F\u0633\u062A\u06CC\u0627\u0628\u06CC \u0628\u0647 \u0633\u0637\u062D
      B2 \u06CC\u0627 \u0628\u0627\u0644\u0627\u062A\u0631 \u0648\u062C\u0648\u062F
      \u0646\u062F\u0627\u0631\u062F."
    m_Metadata:
      m_Items: []
  - m_Id: 6343601774592
    m_Localized: "\u062A\u0648\u0627\u0646\u0627\u06CC\u06CC \u06A9\u0644\u06CC \u06AF\u0641\u062A\u0627\u0631
      \u0631\u0627 \u0627\u0646\u062F\u0627\u0632\u0647\u200C\u06AF\u06CC\u0631\u06CC
      \u0645\u06CC\u200C\u06A9\u0646\u062F."
    m_Metadata:
      m_Items: []
  - m_Id: 6757755740160
    m_Localized: "\u0628\u0631\u0631\u0633\u06CC \u0645\u06CC\u200C\u06A9\u0646\u062F
      \u06A9\u0647 \u0622\u06CC\u0627 \u0648\u0627\u0698\u0647\u200C\u0647\u0627
      \u0631\u0627 \u0628\u0647\u200C\u062F\u0631\u0633\u062A\u06CC \u062A\u0644\u0641\u0638
      \u06A9\u0631\u062F\u0647\u200C\u0627\u06CC\u062F. \u0627\u0646\u062F\u0627\u0632\u0647\u200C\u06AF\u06CC\u0631\u06CC
      \u0645\u06CC\u200C\u06A9\u0646\u062F \u06A9\u0647 \u062F\u0633\u062A\u06AF\u0627\u0647
      \u062A\u0627 \u0686\u0647 \u0627\u0646\u062F\u0627\u0632\u0647 \u0645\u06CC\u200C\u062A\u0648\u0627\u0646\u062F
      \u06AF\u0641\u062A\u0627\u0631 \u0634\u0645\u0627 \u0631\u0627 \u062F\u0631\u06A9
      \u06A9\u0646\u062F."
    m_Metadata:
      m_Items: []
  - m_Id: 6846674984960
    m_Localized: "\u062A\u0646\u0648\u0639 \u0648 \u0627\u0646\u0639\u0637\u0627\u0641\u200C\u067E\u0630\u06CC\u0631\u06CC
      \u062F\u0631 \u0627\u0633\u062A\u0641\u0627\u062F\u0647 \u0627\u0632 \u0632\u0628\u0627\u0646
      \u0631\u0627 \u0627\u0646\u062F\u0627\u0632\u0647\u200C\u06AF\u06CC\u0631\u06CC
      \u0645\u06CC\u200C\u06A9\u0646\u062F."
    m_Metadata:
      m_Items: []
  - m_Id: 6874936205312
    m_Localized: "\u062F\u0642\u062A\u060C \u0635\u062D\u062A \u0648 \u0645\u06CC\u0632\u0627\u0646
      \u0631\u0639\u0627\u06CC\u062A \u0642\u0648\u0627\u0639\u062F \u062F\u0633\u062A\u0648\u0631\u06CC
