  m_TableData:
  - m_Id: 5787193794560
    m_Localized: "<b>\u0986\u09AA\u09A8\u09BE\u09B0 \u09AC\u09A8\u09CD\u09A7\u09C1\u09B0
      \u0995\u09BE\u099B\u09C7 \u09AC\u09C7\u09B6\u09BF \u099F\u09BE\u0995\u09BE
      \u09A8\u09C7\u0987 \u098F\u09AC\u0982 \u09B8\u09C7 \u0986\u09AA\u09A8\u09BE\u09B0
      \u0995\u09BE\u099B\u09C7 \u09E7\u09E6\u09E6 \u0987\u0989\u09B0\u09CB \u099A\u09BE\u0987\u099B\u09C7\u0964
      \u0986\u09AA\u09A8\u09BF \u09A4\u09BE\u0995\u09C7 \u0995\u09C0 \u09AC\u09B2\u09AC\u09C7\u09A8?</b>\\n\u0986\u09AA\u09A8\u09BE\u09B0
      \u0995\u09BE\u099B\u09C7 \u09E9\u09E6 \u09B8\u09C7\u0995\u09C7\u09A8\u09CD\u09A1
      \u09B8\u09AE\u09AF\u09BC \u0986\u099B\u09C7\u0964"
    m_Metadata:
      m_Items: []
  - m_Id: 5905867431936
    m_Localized: "<b>\u0986\u09AA\u09A8\u09BF \u0986\u099C \u0995\u09CD\u09B2\u09BE\u09B8\u09C7/\u0995\u09BE\u099C\u09C7
      \u0986\u09B8\u09A4\u09C7 \u09AA\u09BE\u09B0\u09AC\u09C7\u09A8 \u09A8\u09BE\u0964
      \u0986\u09AA\u09A8\u09BF \u0986\u09AA\u09A8\u09BE\u09B0 \u09B6\u09BF\u0995\u09CD\u09B7\u0995/\u09AC\u09B8\u0995\u09C7
      \u098F\u0995\u099F\u09BF \u09AD\u09AF\u09BC\u09C7\u09B8 \u09AE\u09C7\u09B8\u09C7\u099C
      \u09AA\u09BE\u09A0\u09BF\u09AF\u09BC\u09C7 \u099C\u09BE\u09A8\u09BE\u099A\u09CD\u099B\u09C7\u09A8
      \u0995\u09C7\u09A8 \u0986\u09B8\u09A4\u09C7 \u09AA\u09BE\u09B0\u09AC\u09C7\u09A8
      \u09A8\u09BE\u0964 \u09AE\u09C7\u09B8\u09C7\u099C\u09C7 \u0986\u09AA\u09A8\u09BF
      \u0995\u09C0 \u09AC\u09B2\u09AC\u09C7\u09A8?</b>\\n\u0986\u09AA\u09A8\u09BE\u09B0
      \u0995\u09BE\u099B\u09C7 \u09E9\u09E6 \u09B8\u09C7\u0995\u09C7\u09A8\u09CD\u09A1
      \u09B8\u09AE\u09AF\u09BC \u0986\u099B\u09C7\u0964"
    m_Metadata:
      m_Items: []
  - m_Id: 5937198882816
    m_Localized: "<b>\u0986\u09AA\u09A8\u09BF \u09B8\u09BE\u09A7\u09BE\u09B0\u09A3\u09A4
      \u09AC\u09BE\u09A1\u09BC\u09BF\u09A4\u09C7 \u0995\u09C0 \u0995\u09B0\u09C7\u09A8,
      \u09A4\u09BE \u09AC\u09B0\u09CD\u09A3\u09A8\u09BE \u0995\u09B0\u09C1\u09A8\u0964</b>\\n\u0986\u09AA\u09A8\u09BE\u09B0
      \u0995\u09BE\u099B\u09C7 \u09E7 \u09AE\u09BF\u09A8\u09BF\u099F \u09B8\u09AE\u09AF\u09BC
      \u0986\u099B\u09C7\u0964"
    m_Metadata:
      m_Items: []
  - m_Id: 5953061740544
    m_Localized: "<b>\u0986\u09AA\u09A8\u09BF \u0995\u09CB\u09A8 \u0995\u09CB\u09A8
      \u09AD\u09BE\u09B7\u09BE \u0995\u09CB\u09A5\u09BE\u09AF\u09BC \u09AC\u09CD\u09AF\u09AC\u09B9\u09BE\u09B0
      \u0995\u09B0\u09C7\u09A8 \u09A4\u09BE \u09AC\u09B0\u09CD\u09A3\u09A8\u09BE
      \u0995\u09B0\u09C1\u09A8\u0964</b>\\n\u25CF \u09AC\u09BE\u09A1\u09BC\u09BF\u09A4\u09C7,
      \u09A6\u09CB\u0995\u09BE\u09A8\u09C7, \u0995\u09BE\u099C\u09C7... \u0986\u09AA\u09A8\u09BF
      \u0995\u09CB\u09A8 \u0995\u09CB\u09A8 \u09AD\u09BE\u09B7\u09BE\u09AF\u09BC
      \u0995\u09A5\u09BE \u09AC\u09B2\u09C7\u09A8?\\n\u25CF \u0986\u09AA\u09A8\u09BF
      \u0995\u09BF \u0985\u09A8\u09CD\u09AF \u0995\u09CB\u09A8\u09CB \u09AD\u09BE\u09B7\u09BE\u09AF\u09BC
      \u099F\u09BF\u09AD\u09BF \u09A6\u09C7\u0996\u09C7\u09A8 \u09AC\u09BE \u0997\u09BE\u09A8
      \u09B6\u09CB\u09A8\u09C7\u09A8?\\n\u25CF \u0986\u09AA\u09A8\u09BF \u0995\u09CB\u09A8
      \u0995\u09CB\u09A8 \u09AD\u09BE\u09B7\u09BE\u09AF\u09BC \u09AA\u09A1\u09BC\u09C7\u09A8
      \u0993 \u09B2\u09C7\u0996\u09C7\u09A8?\\n\u0986\u09AA\u09A8\u09BE\u09B0 \u0995\u09BE\u099B\u09C7
      \u09E7 \u09AE\u09BF\u09A8\u09BF\u099F \u09B8\u09AE\u09AF\u09BC \u0986\u099B\u09C7\u0964"
    m_Metadata:
      m_Items: []
  - m_Id: 5968836517888
    m_Localized: "<b>\u0986\u09AA\u09A8\u09BE\u09B0 \u0995\u09C7\u09A8\u09BE\u0995\u09BE\u099F\u09BE\u09B0
      \u0985\u09AD\u09CD\u09AF\u09BE\u09B8 \u09AC\u09BE \u0989\u09AA\u09B0\u09C7\u09B0
      \u099B\u09AC\u09BF\u09B0 \u09AD\u09BF\u09A4\u09CD\u09A4\u09BF\u09A4\u09C7 \u0989\u09A4\u09CD\u09A4\u09B0
      \u09A6\u09BF\u09A8\u0964</b>\\n\u25CF \u0986\u09AA\u09A8\u09BF \u09B8\u09BE\u09A7\u09BE\u09B0\u09A3\u09A4
      \u09A6\u09CB\u0995\u09BE\u09A8 \u09A5\u09C7\u0995\u09C7 \u0995\u09C0 \u0995\u09C7\u09A8\u09C7\u09A8?\\n\u25CF
      \u0986\u09AA\u09A8\u09BF \u09B8\u09BE\u09A7\u09BE\u09B0\u09A3\u09A4 \u09A6\u09CB\u0995\u09BE\u09A8
      \u09A5\u09C7\u0995\u09C7 \u0995\u09C0 \u0995\u09C7\u09A8\u09C7\u09A8 \u09A8\u09BE?\\n\u25CF
      \u0986\u09AA\u09A8\u09BF \u09B8\u09BE\u09A7\u09BE\u09B0\u09A3\u09A4 \u0995\u0996\u09A8
      \u0995\u09C7\u09A8\u09BE\u0995\u09BE\u099F\u09BE \u0995\u09B0\u09A4\u09C7 \u09AF\u09BE\u09A8?\\n\u0986\u09AA\u09A8\u09BE\u09B0
      \u0995\u09BE\u099B\u09C7 \u09E7 \u09AE\u09BF\u09A8\u09BF\u099F \u09B8\u09AE\u09AF\u09BC
      \u0986\u099B\u09C7\u0964"
    m_Metadata:
      m_Items: []
  - m_Id: 7498574684160
    m_Localized: "\u09B6\u09C1\u09A8\u09C1\u09A8!"
