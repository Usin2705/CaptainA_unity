    m_Localized: "\u0627\u0631\u0632\u06CC\u0627\u0628\u06CC \u062E\u0648\u062F\u06A9\u0627\u0631
      \u06AF\u0641\u062A\u0627\u0631 \u0628\u0631\u0627\u06CC \u0627\u0645\u062A\u06CC\u0627\u0632\u062F\u0647\u06CC
      \u062E\u0648\u062F\u06A9\u0627\u0631 \u0648 \u0628\u0647\u0628\u0648\u062F
      \u0645\u062F\u0644 \u0647\u0648\u0634 \u0645\u0635\u0646\u0648\u0639\u06CC
      \u0646\u06CC\u0627\u0632 \u0628\u0647 \u062C\u0645\u0639\u200C\u0622\u0648\u0631\u06CC
      \u062F\u0627\u062F\u0647\u200C\u0647\u0627\u06CC \u0634\u0645\u0627 \u062F\u0627\u0631\u062F.
      \u0644\u0637\u0641\u0627\u064B \u0646\u062D\u0648\u0647 \u067E\u0631\u062F\u0627\u0632\u0634
      \u062F\u0627\u062F\u0647\u200C\u0647\u0627\u06CC \u062E\u0648\u062F \u0631\u0627
      \u0628\u0631\u0631\u0633\u06CC \u06A9\u0646\u06CC\u062F."
