  m_Script: {fileID: 11500000, guid: e9620f8c34305754d8cc9a7e49e852d9, type: 3}
  m_Name: ASAPanel Labels_ru
  m_EditorClassIdentifier: Unity.Localization::UnityEngine.Localization.Tables.StringTable
  m_LocaleId:
    m_Code: ru
  m_SharedData: {fileID: 11400000, guid: d3a4387299faa8b81aed682b3107b9e1, type: 2}
  m_Metadata:
    m_Items: []
  m_TableData:
  - m_Id: 5787193794560
    m_Localized: "<b>\u0423 \u0442\u0432\u043E\u0435\u0433\u043E \u0434\u0440\u0443\u0433\u0430
      \u043C\u0430\u043B\u043E \u0434\u0435\u043D\u0435\u0433, \u0438 \u043E\u043D
      \u043F\u0440\u043E\u0441\u0438\u0442 \u0443 \u0442\u0435\u0431\u044F 100 \u0435\u0432\u0440\u043E.
      \u0427\u0442\u043E \u0442\u044B \u043E\u0442\u0432\u0435\u0442\u0438\u0448\u044C
      \u0435\u043C\u0443?</b>\\n\u0423 \u0442\u0435\u0431\u044F \u0435\u0441\u0442\u044C
      30 \u0441\u0435\u043A\u0443\u043D\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 5905867431936
    m_Localized: "<b>\u0421\u0435\u0433\u043E\u0434\u043D\u044F \u0442\u044B \u043D\u0435
      \u043C\u043E\u0436\u0435\u0448\u044C \u043F\u0440\u0438\u0439\u0442\u0438 \u043D\u0430
      \u0437\u0430\u043D\u044F\u0442\u0438\u044F/\u043D\u0430 \u0440\u0430\u0431\u043E\u0442\u0443.
      \u0422\u044B \u043E\u0442\u043F\u0440\u0430\u0432\u043B\u044F\u0435\u0448\u044C
      \u0433\u043E\u043B\u043E\u0441\u043E\u0432\u043E\u0435 \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0435
      \u0441\u0432\u043E\u0435\u043C\u0443 \u0443\u0447\u0438\u0442\u0435\u043B\u044E/\u043D\u0430\u0447\u0430\u043B\u044C\u043D\u0438\u043A\u0443
      \u0438 \u043E\u0431\u044A\u044F\u0441\u043D\u044F\u0435\u0448\u044C, \u043F\u043E\u0447\u0435\u043C\u0443
      \u043D\u0435 \u043C\u043E\u0436\u0435\u0448\u044C \u043F\u0440\u0438\u0439\u0442\u0438.
      \u0427\u0442\u043E \u0442\u044B \u0441\u043A\u0430\u0436\u0435\u0448\u044C
      \u0432 \u0441\u043E\u043E\u0431\u0449\u0435\u043D\u0438\u0438.</b>\\n\u0423
      \u0442\u0435\u0431\u044F \u0435\u0441\u0442\u044C 30 \u0441\u0435\u043A\u0443\u043D\u0434."
    m_Metadata:
      m_Items: []
  - m_Id: 5937198882816
    m_Localized: "<b>\u041E\u043F\u0438\u0448\u0438, \u0447\u0435\u043C \u0442\u044B
      \u043E\u0431\u044B\u0447\u043D\u043E \u0437\u0430\u043D\u0438\u043C\u0430\u0435\u0448\u044C\u0441\u044F
      \u0434\u043E\u043C\u0430.</b>\\n\u0423 \u0442\u0435\u0431\u044F \u0435\u0441\u0442\u044C
      1 \u043C\u0438\u043D\u0443\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 5953061740544
    m_Localized: "<b>\u0420\u0430\u0441\u0441\u043A\u0430\u0436\u0442, \u043A\u0430\u043A\u0438\u043C\u0438
      \u044F\u0437\u044B\u043A\u0430\u043C\u0438 \u0442\u044B \u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0448\u044C\u0441\u044F
      \u0438 \u0433\u0434\u0435.</b>\\n\u25CF \u041D\u0430 \u043A\u0430\u043A\u0438\u0445
      \u044F\u0437\u044B\u043A\u0430\u0445 \u0442\u044B \u0440\u0430\u0437\u0433\u043E\u0432\u0430\u0440\u0438\u0432\u0430\u0435\u0448\u044C
      \u0434\u043E\u043C\u0430, \u0432 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0435,
      \u043D\u0430 \u0440\u0430\u0431\u043E\u0442\u0435...?\\n\u25CF \u0421\u043C\u043E\u0442\u0440\u0438\u0448\u044C
      \u043B\u0438 \u0442\u044B \u0442\u0435\u043B\u0435\u0432\u0438\u0437\u043E\u0440
      \u0438\u043B\u0438 \u0441\u043B\u0443\u0448\u0430\u0435\u0448\u044C \u043C\u0443\u0437\u044B\u043A\u0443
      \u043D\u0430 \u0434\u0440\u0443\u0433\u043E\u043C \u0443\u0437\u044B\u043A\u0435?\\n\u25CF
      \u041D\u0430 \u043A\u0430\u043A\u0438\u0445 \u044F\u0437\u044B\u043A\u0430\u0445
      \u0442\u044B \u0447\u0438\u0442\u0430\u0435\u0448\u044C \u0438 \u043F\u0438\u0448\u0435\u0448\u044C?\\n\u0423
      \u0442\u0435\u0431\u044F \u0435\u0441\u0442\u044C 1 \u043C\u0438\u043D\u0443\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 5968836517888
    m_Localized: "<b>\u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430,
      \u043E\u0442\u0432\u0435\u0442\u044C, \u0438\u0441\u0445\u043E\u0434\u044F
      \u0438\u0437 \u0441\u0432\u043E\u0438\u0445 \u043F\u043E\u043A\u0443\u043F\u0430\u0442\u0435\u043B\u044C\u0441\u043A\u0438\u0445
      \u043F\u0440\u0438\u0432\u044B\u0447\u0435\u043A \u0438\u043B\u0438 \u043F\u043E
      \u043A\u0430\u0440\u0442\u0438\u043D\u043A\u0435 \u0432\u044B\u0448\u0435.</b>\\n\u25CF
      \u0427\u0442\u043E \u0442\u044B \u043E\u0431\u044B\u0447\u043D\u043E \u043F\u043E\u043A\u0443\u043F\u0430\u0435\u0448\u044C
      \u0432 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0435?\\n\u25CF \u0427\u0442\u043E
      \u0442\u044B \u043E\u0431\u044B\u0447\u043D\u043E \u043D\u0435 \u043F\u043E\u043A\u0443\u043F\u0430\u0435\u0448\u044C
      \u0432 \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0435?\\n\u25CF \u041A\u043E\u0433\u0434\u0430
      \u0442\u044B \u043E\u0431\u044B\u0447\u043D\u043E \u0445\u043E\u0434\u0438\u0448\u044C
      \u0437\u0430 \u043F\u043E\u043A\u0443\u043F\u043A\u0430\u043C\u0438?\\n\u0423
      \u0442\u0435\u0431\u044F 1 \u043C\u0438\u043D\u0443\u0442\u0430."
    m_Metadata:
      m_Items: []
  - m_Id: 7498574684160
    m_Localized: "\u041F\u0440\u043E\u0441\u043B\u0443\u0448\u0430\u0442\u044C"
    m_Metadata:
      m_Items: []
  - m_Id: 7558490316800
    m_Localized: "\u0420\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 9693009371136
    m_Localized: "\u0420\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u044B"
    m_Metadata:
      m_Items: []
  - m_Id: 9854129364992
    m_Localized: "\u041A\u0430\u043A \u0442\u0435\u0431\u0435 \u044D\u0442\u043E
      \u0437\u0430\u0434\u0430\u043D\u0438\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 9990498770944
    m_Localized: "\u0417\u0434\u0435\u0441\u044C \u0442\u044B \u043C\u043E\u0436\u0435\u0448\u044C
      \u043E\u0441\u0442\u0430\u0432\u0438\u0442\u044C \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u043E\u0442\u0437\u044B\u0432 (\u043D\u0435 \u0431\u043E\u043B\u0435\u0435
      250 \u0441\u0438\u043C\u0432\u043E\u043B\u043E\u0432)."
    m_Metadata:
      m_Items: []
  - m_Id: 2573893778890752
    m_Localized: "\u041E\u0442\u043F\u0440\u0430\u0432\u043A\u0430 \u0430\u0443\u0434\u0438\u043E\u0437\u0430\u043F\u0438\u0441\u0438..."
    m_Metadata:
      m_Items: []
  - m_Id: 2574131100999680
    m_Localized: "\u041D\u0435 \u0443\u0434\u0430\u043B\u043E\u0441\u044C \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u0442\u044C
      \u0430\u0443\u0434\u0438\u043E\u0437\u0430\u043F\u0438\u0441\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 2574532344897536
    m_Localized: "\u0422\u0432\u043E\u0438 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u044B
      \u0433\u043E\u0442\u043E\u0432\u044B. \u041D\u0430\u0436\u043C\u0438 \u043D\u0438\u0436\u0435,
      \u0447\u0442\u043E\u0431\u044B \u0438\u0445 \u0443\u0432\u0438\u0434\u0435\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 6320358917496832
    m_Localized: "\u041D\u0435\u0442 \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u044F.
      \u041F\u0440\u043E\u0432\u0435\u0440\u044C \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435\u043A
      \u0441\u0435\u0442\u0438 \u0438 \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0439
      \u0435\u0449\u0451 \u0440\u0430\u0437."
    m_Metadata:
      m_Items: []
  - m_Id: 6321177507225600
    m_Localized: "\u0414\u043B\u044F \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044F
      \u044D\u0442\u043E\u0439 \u0444\u0443\u043D\u043A\u0446\u0438\u0438 \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F
      \u0442\u0432\u043E\u0451 \u0441\u043E\u0433\u043B\u0430\u0441\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 6321228962947072
    m_Localized: "\u0422\u0432\u043E\u044F \u0443\u0447\u0451\u0442\u043D\u0430\u044F
      \u0437\u0430\u043F\u0438\u0441\u044C \u043D\u0435 \u043D\u0430\u0439\u0434\u0435\u043D\u0430.
      \u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E, \u0442\u0435\u0431\u0435
      \u043F\u043E\u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F \u0437\u0430\u043D\u043E\u0432\u043E
      \u043D\u0430\u0441\u0442\u0440\u043E\u0438\u0442\u044C \u043F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 6321274882187264
    m_Localized: "\u042D\u0442\u0430 \u0432\u0435\u0440\u0441\u0438\u044F \u043F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u0435
      \u043D\u0435 \u0431\u044B\u043B\u0430 \u043F\u0440\u0438\u043D\u044F\u0442\u0430
      \u0441\u0435\u0440\u0432\u0435\u0440\u043E\u043C. \u041E\u0431\u043D\u043E\u0432\u0438
      \u043F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u0438\u043B\u0438
      \u0441\u0432\u044F\u0436\u0438\u0441\u044C \u0441 \u043D\u0430\u043C\u0438,
      \u0435\u0441\u043B\u0438 \u043E\u043D\u043E \u0443\u0436\u0435 \u043E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u043E
      \u0434\u043E \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0439 \u0432\u0435\u0440\u0441\u0438\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 6321523981901824
    m_Localized: "\u0410\u0443\u0434\u0438\u043E\u0437\u0430\u043F\u0438\u0441\u044C
      \u0441\u043B\u0438\u0448\u043A\u043E\u043C \u0434\u043B\u0438\u043D\u043D\u0430\u044F
      \u0434\u043B\u044F \u043E\u0442\u043F\u0440\u0430\u0432\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 6321580026191872
    m_Localized: "\u0421\u0435\u0440\u0432\u0435\u0440 \u0437\u0430\u043D\u044F\u0442.
      \u041F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0439
      \u0441\u043D\u043E\u0432\u0430 \u0447\u0435\u0440\u0435\u0437 \u043D\u0435\u043A\u043E\u0442\u043E\u0440\u043E\u0435
      \u0432\u0440\u0435\u043C\u044F."
    m_Metadata:
      m_Items: []
  - m_Id: 6321609004638208
    m_Localized: "\u041F\u0440\u0438\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u043B\u043E
      \u0434\u0430\u043D\u043D\u044B\u0435, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u0441\u0435\u0440\u0432\u0435\u0440 \u043D\u0435 \u0441\u043C\u043E\u0433
      \u043F\u0440\u0438\u043D\u044F\u0442\u044C."
    m_Metadata:
      m_Items: []
  - m_Id: 6321645155344384
    m_Localized: "\u041F\u0440\u043E\u0438\u0437\u043E\u0448\u043B\u0430 \u043E\u0448\u0438\u0431\u043A\u0430,
      \u043F\u043E\u0436\u0430\u043B\u0443\u0439\u0441\u0442\u0430, \u043F\u043E\u043F\u0440\u043E\u0431\u0443\u0439
      \u0435\u0449\u0451 \u0440\u0430\u0437."
    m_Metadata:
      m_Items: []
  references:
    version: 2
    RefIds: []
