    m_Metadata:
      m_Items: []
  - m_Id: 19380538793984
    m_Localized: "\u0422\u043E\u043F {0}"
    m_Metadata:
      m_Items: []
  - m_Id: 19467973255168
    m_Localized: "\u041F\u0440\u043E\u0434\u043E\u0432\u0436\u0443\u0439\u0442\u0435
      \u0442\u0440\u0435\u043D\u0443\u0432\u0430\u0442\u0438\u0441\u044F, \u0449\u043E\u0431
      \u043F\u043E\u0431\u0430\u0447\u0438\u0442\u0438, \u044F\u043A \u0432\u0438
      \u0432\u0438\u0433\u043B\u044F\u0434\u0430\u0454\u0442\u0435 \u043F\u043E\u0440\u0456\u0432\u043D\u044F\u043D\u043E
      \u0437 \u0456\u043D\u0448\u0438\u043C\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 19548101238784
    m_Localized: "\u041F\u0440\u043E\u0434\u043E\u0432\u0436\u0443\u0439\u0442\u0435
      \u0442\u0440\u0435\u043D\u0443\u0432\u0430\u0442\u0438\u0441\u044F, \u0449\u043E\u0431
      \u043F\u043E\u0431\u0430\u0447\u0438\u0442\u0438 \u0441\u0432\u043E\u0454 \u043C\u0456\u0441\u0446\u0435
      \u0441\u0435\u0440\u0435\u0434 \u0456\u043D\u0448\u0438\u0445 {0} \u0443\u0447\u043D\u0456\u0432."
    m_Metadata:
      m_Items: []
  - m_Id: 20111354322944
    m_Localized: "\u041D\u0430 \u0432\u0430\u0448\u043E\u043C\u0443 \u0440\u0456\u0432\u043D\u0456
      \u043F\u043E\u043A\u0438 \u0449\u043E \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043D\u044C\u043E
      \u0443\u0447\u043D\u0456\u0432 \u0434\u043B\u044F \u043F\u043E\u0440\u0456\u0432\u043D\u044F\u043D\u043D\u044F.
      \u041F\u0435\u0440\u0435\u0432\u0456\u0440\u0442\u0435 \u043F\u0456\u0437\u043D\u0456\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 20288265871360
    m_Localized: "\u041D\u0430\u0440\u0430\u0437\u0456 \u0432\u0430\u0448 \u0440\u0435\u0439\u0442\u0438\u043D\u0433
      \u043D\u0435\u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0438\u0439. \u0421\u043F\u0440\u043E\u0431\u0443\u0439\u0442\u0435
      \u0449\u0435 \u0440\u0430\u0437 \u043F\u0456\u0437\u043D\u0456\u0448\u0435."
    m_Metadata:
      m_Items: []
  - m_Id: 20790462472192
    m_Localized: "\u041D\u0430\u0440\u0430\u0437\u0456 \u0432\u0430\u0448 \u0440\u0435\u0439\u0442\u0438\u043D\u0433
      \u043D\u0435\u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0438\u0439."
    m_Metadata:
      m_Items: []
  - m_Id: 20982267994112
    m_Localized: "\u0429\u043E \u0432\u0438 \u0434\u0443\u043C\u0430\u0454\u0442\u0435?"
    m_Metadata:
      m_Items: []
  - m_Id: 33204755062784
    m_Localized: "\u0427\u0438 \u0431\u0443\u043B\u043E \u0446\u0435 \u043F\u043E\u0440\u0456\u0432\u043D\u044F\u043D\u043D\u044F
      \u043A\u043E\u0440\u0438\u0441\u043D\u0438\u043C?"
    m_Metadata:
      m_Items: []
  - m_Id: 33286875340800
    m_Localized: "\u0422\u0443\u0442 \u0432\u0438 \u043C\u043E\u0436\u0435\u0442\u0435
      \u043D\u0430\u0434\u0430\u0442\u0438 \u0434\u043E\u0434\u0430\u0442\u043A\u043E\u0432\u0438\u0439
      \u0432\u0456\u0434\u0433\u0443\u043A (\u043C\u0430\u043A\u0441. 250 \u0441\u0438\u043C\u0432\u043E\u043B\u0456\u0432)."
    m_Metadata:
      m_Items: []
  - m_Id: 33519696961536
    m_Localized: "\u041D\u0430\u0434\u0456\u0441\u043B\u0430\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 33665952342016
    m_Localized: "\u041D\u0430\u043B\u0430\u0448\u0442\u0443\u0432\u0430\u043D\u043D\u044F"
    m_Metadata:
      m_Items: []
  - m_Id: 33710621679616
    m_Localized: "\u0412\u0430\u0448 \u0456\u0434\u0435\u043D\u0442\u0438\u0444\u0456\u043A\u0430\u0442\u043E\u0440
      \u043A\u043E\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0430 \u043F\u043E\u0442\u0440\u0456\u0431\u0435\u043D,
      \u044F\u043A\u0449\u043E \u0432\u0438 \u0437\u0430\u0445\u043E\u0447\u0435\u0442\u0435
      \u0437\u0432\u0435\u0440\u043D\u0443\u0442\u0438\u0441\u044F \u0434\u043E \u0441\u043B\u0443\u0436\u0431\u0438
      \u043F\u0456\u0434\u0442\u0440\u0438\u043C\u043A\u0438."
    m_Metadata:
      m_Items: []
  - m_Id: 33884240699392
    m_Localized: "\u041A\u043E\u043F\u0456\u044E\u0432\u0430\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 34023055384576
    m_Localized: "\u0412\u0438\u0434\u0430\u043B\u0438\u0442\u0438 \u043C\u043E\u0457
      \u0434\u0430\u043D\u0456"
    m_Metadata:
      m_Items: []
  - m_Id: 34292610719744
    m_Localized: "\u0412\u0438\u0434\u0430\u043B\u0438\u0442\u0438 \u0432\u0430\u0448\u0456
      \u0434\u0430\u043D\u0456?"
    m_Metadata:
      m_Items: []
  - m_Id: 34375829905408
    m_Localized: "\u0426\u0435 \u043D\u0430\u0437\u0430\u0432\u0436\u0434\u0438 \u0432\u0438\u0434\u0430\u043B\u0438\u0442\u044C
      \u0456\u0437 \u0446\u044C\u043E\u0433\u043E \u043F\u0440\u0438\u0441\u0442\u0440\u043E\u044E
      \u0442\u0430 \u0437 \u043D\u0430\u0448\u0438\u0445 \u0441\u0435\u0440\u0432\u0435\u0440\u0456\u0432
      \u0432\u0430\u0448\u0456 \u0434\u0430\u043D\u0456 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0447\u043D\u043E\u0433\u043E
      \u043E\u0446\u0456\u043D\u044E\u0432\u0430\u043D\u043D\u044F \u0443\u0441\u043D\u043E\u0433\u043E
      \u043C\u043E\u0432\u043B\u0435\u043D\u043D\u044F, \u0437\u043E\u043A\u0440\u0435\u043C\u0430
      \u0437\u0430\u043F\u0438\u0441\u0438, \u0431\u0430\u043B\u0438 \u0439 \u043E\u0431\u043B\u0456\u043A\u043E\u0432\u0438\u0439
      \u0437\u0430\u043F\u0438\u0441 \u043E\u0446\u0456\u043D\u044E\u0432\u0430\u043D\u043D\u044F.\\n\\n\u0426\u044E
      \u0434\u0456\u044E \u043D\u0435\u043C\u043E\u0436\u043B\u0438\u0432\u043E \u0441\u043A\u0430\u0441\u0443\u0432\u0430\u0442\u0438.
      \u041C\u0438 \u043D\u0435 \u0437\u043C\u043E\u0436\u0435\u043C\u043E \u0432\u0456\u0434\u043D\u043E\u0432\u0438\u0442\u0438
      \u0432\u0438\u0434\u0430\u043B\u0435\u043D\u0456 \u0434\u0430\u043D\u0456."
    m_Metadata:
      m_Items: []
  - m_Id: 34516402003968
    m_Localized: "\u0421\u043A\u0430\u0441\u0443\u0432\u0430\u0442\u0438"
    m_Metadata:
      m_Items: []
  - m_Id: 34665522094080
