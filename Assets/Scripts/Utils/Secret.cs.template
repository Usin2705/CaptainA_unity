// Template for Assets/Scripts/Utils/Secret.cs
//
// The real Secret.cs is gitignored (.gitignore line 68), so it never reaches the
// repository. This template is tracked instead: it records *which* fields the code
// expects, so a fresh clone knows what to fill in and so restoring old code from git
// history does not fail on a field nobody remembers.
//
// To use: copy this file to Secret.cs in the same folder and fill in the values.
// Ask a maintainer for the real values - they are not stored anywhere in this repo.
//
// Do NOT rename this to a .cs file and leave it in place. Unity compiles every .cs
// under Assets/, so two files declaring `Secret` would be a duplicate class error.
//
// Every field is a plain const string. Keep this template in sync when you add or
// remove one.

public static class Secret
{
    // ===================== DTA / ASA server =====================
    // The speech assessment backend: github.com/aalto-speech/dta-server
    // Full endpoint contract in docs/TO_FRONTEND.md.
    // Hostnames are deliberately not published in this repository.

    // Each of these is a full endpoint URL. The /api/v1 prefix is added by the reverse
    // proxy, so they take the shape https://<domain>/api/v1/<endpoint>.

    // POST /speech/assess - uploads a WAV recording and returns the AI scores, the
    //   transcript and an assessment_id. Scores are DECIMAL values on the 0-6 CEFR axis
    //   (e.g. 2.41), continuous rather than one of the labels: 0 = below A1, 1 = A1,
    //   2 = A2, 2.5 = A2+, 3 = B1 ... 6 = C2. See Const.CEFR_*.
    public const string ASA_URL = "";

    // POST /onboarding - creates the user, once, after consent and the background form.
    //   Every other ASA endpoint answers 404 until this has succeeded.
    public const string ASA_CONSENT_URL = "";

    // POST /feedback - the USER's opinion of the ASA feature, not the AI's assessment
    //   of the user. A 1-5 emoji scale (very sad, sad, neutral, happy, very happy)
    //   plus an optional comment. Nothing to do with CEFR - that is ASA_URL above,
    //   whose scores are decimals on the 0-6 axis. Named USER_ASA_FEEDBACK to keep
    //   those two apart. The assessment-scoped types also carry an assessment_id.
    public const string USER_ASA_FEEDBACK_URL = "";

    // POST /analytics/comparison - where this user ranks against others at the same
    //   self-reported CEFR level. Drives the profile screen.
    public const string ASA_PROFILE_URL = "";

    // POST /request/user with type=delete - asks the server to erase this user. The
    //   server deletes on receipt and always answers 'request received', so a success
    //   here means the request landed, not that the data is already gone.
    public const string DATA_DEL_REQUEST_URL = "";

    // Shared client key, sent as the X-Client-Key header on DATA_DEL_REQUEST_URL.
    //   Required - the server answers 403 on a mismatch.
    public const string SERVER_DELETE_KEY = "";

    // ===================== Legacy pronunciation server =====================
    // The older CaptainA MDD server - see docs/legacy_pronunciation_server.md.
    // AUDIO_URL is http rather than https on purpose; see the note in NetworkManager.

    public const string AUDIO_URL = ""; // Mispronunciation detection scoring
    public const string NUMBER_AUDIO_URL = ""; // Number game forced alignment

    // ===================== OpenAI and Azure =====================
    // Used by the GenAI describe-the-picture tasks: Whisper transcription,
    // chat completions for grading, DALL-E image generation and TTS.

    public const string CHATGPT_API = ""; // OpenAI API key, sent as "Bearer <key>"

    // The two Azure fields below are NOT read by any live code. They belonged to the
    // removed GPTRatingVision coroutine and to a commented-out alternative path in
    // GPTRatingText - see docs/legacy_gpt_vision.md. They are kept so that code restored
    // from history still compiles, and so the names are not lost. Safe to delete if the
    // Azure path is never coming back.
    public const string AZUREGPT_API = ""; // Aalto Azure APIM key, Ocp-Apim-Subscription-Key
    public const string AALTO_GPT4O_URL = ""; // Aalto's Azure-hosted GPT-4o endpoint

    // ===================== App =====================
    // Unlock code typed by the user to reveal the advanced and vocabulary panels.

    public const string SECRET_TEXT = "";

    // ===================== Describe-task ground truth =====================
    // Reference descriptions of the task pictures, used as the ground truth in the
    // grading prompt sent to the model (see TextUtils.GetGradingInstruction).
    // They live here rather than in Resources so the answers are not shipped in a
    // readable asset. The _EN variants are the English-language versions of the task.

    public const string ROOM_DESCRIPTION_A0 = "";
    public const string ROOM_DESCRIPTION_A0_EN = "";
    public const string ROOM_DESCRIPTION_A1 = "";
    public const string ROOM_DESCRIPTION_A1_EN = "";

    public const string MISSING_ITEM_B0 = "";
    public const string MISSING_ITEM_B0_EN = "";
    public const string MISSING_ITEM_B1 = "";
    public const string MISSING_ITEM_B1_EN = "";

    // Task C generates its picture at run time, so the description is a generic prompt
    // rather than a fixed room.
    public const string RANDOM_ROOM_DESCRIPTION_C = "";
    public const string RANDOM_ROOM_DESCRIPTION_C_EN = "";
}
