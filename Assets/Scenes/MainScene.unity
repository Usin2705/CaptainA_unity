  loadingPopUpGO: {fileID: 1012582868}
  dimPanelASAGO: {fileID: 431676639}
  loadingIconGO: {fileID: 663327819}
  resultsButtonGO: {fileID: 874353685}
  errorTextGO: {fileID: 1523942761}
  backButtonGO: {fileID: 775814145}
  ratingOptions: {fileID: 949766071}
  feedbackTextGO: {fileID: 1039887686}
  tasks:
  - taskText: Your friend doesn't have much money and asks you for 100 euros. What
      do you say to them?
    taskImage: {fileID: 21300000, guid: 860ca05cf77de784ab06a67436dc880d, type: 3}
    recordingTime: 30
  - taskText: 'You can''t come to class/work today. You send a voice message to your
      teacher/boss and tell them why you can''t come. What do you say in the message?\nYou
      have 30 seconds. '
    taskImage: {fileID: 21300000, guid: eb10ebaeb763ab141a6b77d1ace0d5e8, type: 3}
    recordingTime: 30
  - taskText: '<b>Describe what you normally do at home.</b>\n You have 1 minute. '
    taskImage: {fileID: 21300000, guid: 54863f96f74ba97428c5b66cab2d8b49, type: 3}
    recordingTime: 60
  - taskText: "<b>Describe what languages you use and where.</b>\\n You have 1 minute.\\n\u25CF
      What languages do you speak at home, in the shop, at work...?\\n\u25CF Do you
      watch TV or listen to music in another language? "
    taskImage: {fileID: 21300000, guid: 287bffc133d95004db73f967a7866032, type: 3}
    recordingTime: 60
  - taskText: "<b>In this task, you have 1 minute to answer based on your shopping
      habits or the picture above.</b>\\n\u25CF What do you normally buy at the store?\\n\u25CF
      What don't you normally buy from the store?\\n\u25CF When do you normally go
      shopping? "
    taskImage: {fileID: 21300000, guid: b3bc2904e4b5deb45be6fcab6e50ebcc, type: 3}
    recordingTime: 60
  taskTextGO: {fileID: 1186766482}
  taskImageGO: {fileID: 698106385}
  isLoading: 0
  currentTaskSelected: -1
  errorPopupGO: {fileID: 1946420586}
