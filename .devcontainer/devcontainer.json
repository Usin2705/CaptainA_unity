// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/dotnet
{
  "name": "C# (.NET) & Unity",
  "image": "mcr.microsoft.com/devcontainers/dotnet:2-10.0",
  "features": {
    "ghcr.io/devcontainers/features/node:2": {
      "version": "26"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.15",
      "toolsToInstall": "ruff"
    }
  },
  "mounts": [
    // Required: Same path as the host, which the .csproj files reference.
    "source=${localEnv:HOME}/Unity/Hub/Editor,target=${localEnv:HOME}/Unity/Hub/Editor,type=bind,readonly"
  ],
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "esbenp.prettier-vscode",
        "visualstudiotoolsforunity.vstuc",
        "csharpier.csharpier-vscode",
        "charliermarsh.ruff"
      ]
    }
  },
  "remoteUser": "vscode"
}
